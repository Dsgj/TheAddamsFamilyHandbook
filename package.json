{
  "name": "valvet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Service app for one Bally The Addams Family pinball machine (1992, WPC)",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check && tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "sync-kit": "node scripts/sync-kit.mjs",
    "fonts": "node scripts/copy-fonts.mjs",
    "thumbs": "node scripts/thumbnails.mjs",
    "icons": "node scripts/icons.mjs"
  },
  "dependencies": {
    "@astrojs/svelte": "^9.0.1",
    "@vite-pwa/astro": "^1.2.0",
    "astro": "^7.3.4",
    "marked": "^18.0.14",
    "svelte": "^5.57.1",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@fontsource/ibm-plex-mono": "^5.2.0",
    "@fontsource/ibm-plex-sans": "^5.2.0",
    "@fontsource/im-fell-english-sc": "^5.2.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-astro": "^1.3.0",
    "eslint-plugin-svelte": "^3.0.0",
    "prettier": "^3.6.0",
    "prettier-plugin-astro": "^0.14.0",
    "prettier-plugin-svelte": "^3.4.0",
    "sharp": "^0.34.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.40.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@12.5.1"
}
