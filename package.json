{
  "name": "the-addams-family-handbook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Service app for one Bally The Addams Family pinball machine (1992, WPC)",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check && tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "sync-kit": "node scripts/sync-kit.mjs",
    "fonts": "node scripts/copy-fonts.mjs",
    "thumbs": "node scripts/thumbnails.mjs",
    "icons": "node scripts/icons.mjs",
    "svelte-check": "astro sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@astrojs/svelte": "^9.0.1",
    "@vite-pwa/astro": "^1.2.0",
    "astro": "^7.3.5",
    "marked": "^18.0.14",
    "svelte": "^5.57.1",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@fontsource/ibm-plex-mono": "^5.2.0",
    "@fontsource/ibm-plex-sans": "^5.2.0",
    "@fontsource/im-fell-english-sc": "^5.2.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-playwright": "^2.12.0",
    "eslint-plugin-svelte": "^3.0.0",
    "js-yaml": "^5.4.2",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "prettier-plugin-svelte": "^4.1.1",
    "sharp": "^0.35.5",
    "svelte-check": "^4.7.6",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@12.5.1"
}
