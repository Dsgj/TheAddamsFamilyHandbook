---
import Base from '~/layouts/Base.astro';
import Matrix from '~/components/Matrix.svelte';
import { DATA } from '~/lib/data/components';
import { INSTALLED_FLASHERS, LED_KIT_SOURCE } from '~/data/installedLeds';
import { KIND_PLURAL, TABLE_LABEL } from '~/lib/copy';
import { pageTitleText } from '~/lib/pages';
import { componentHref, href, manualHref } from '~/lib/url';
import { positions } from '~/lib/data/positions';
import { offMap } from '~/lib/present';

const cells = DATA.lamps.map((l) => ({
  id: l.id,
  name: l.name,
  col: l.col,
  row: l.row,
  unused: l.unused,
  off: positions('lamp', l.id).length ? undefined : offMap('lamp', l),
}));
---

<Base
  title={TABLE_LABEL.lamp}
  short={KIND_PLURAL.lamp}
  nav="lamps"
  description="The lamp matrix with bulb numbers and a Fault tick per lamp."
>
  <h1>Lamp matrix</h1>
  <p class="muted">
    Columns from J137/J138 (Q90–Q98), rows from J133/J134 (Q80–Q88). Source:{' '}
    <a href={manualHref('ops', 104)}>Lamp Matrix {pageTitleText('ops', 104)}</a>. Lamps marked
    speaker sit in the speaker panel, not on the playfield.
  </p>
  <Matrix client:load kind="lamp" cells={cells} cols={DATA.lCols} rows={DATA.lRows} />

  <section class="card lamps">
    <h2>All lamps</h2>
    <p class="muted small">
      Tick Fault to put the lamp on the <a href={href('shopping')}>shopping list</a> with the LED to order.
      It turns red in the matrix and on the map. Installed is the LED fitted in this machine ({
        LED_KIT_SOURCE
      }); Bulb is the manual's socket type.
    </p>
    <div class="scroll-x">
      <table class="t two" role="table">
        <thead role="rowgroup">
          <tr role="row">
            <th role="columnheader" class="key">#</th>
            <th role="columnheader">Name</th>
            <th role="columnheader">Installed</th>
            <th role="columnheader">Bulb</th>
            <th role="columnheader">Part</th>
            <th role="columnheader">Assembly</th>
            <th role="columnheader" class="chk">Fault</th>
          </tr>
        </thead>
        <tbody role="rowgroup">
          {
            DATA.lamps.map((l) => (
              <tr role="row" class:list={[{ muted: l.unused }]}>
                <td role="cell" class="key">
                  <a class="mono" href={componentHref('lamp', l.id)}>
                    {l.id}
                  </a>
                </td>
                <td role="cell" class="nm">
                  {l.name}
                  {l.speaker && (
                    <span class="note muted small">
                      <span class="sep"> · </span>speaker panel
                    </span>
                  )}
                </td>
                <td role="cell" class="mono" data-h="Installed">
                  {l.led}
                </td>
                <td role="cell" class="mono" data-h="Bulb">
                  {l.bulb}
                </td>
                <td role="cell" class="mono" data-h="Part">
                  {l.bulbPart}
                </td>
                <td role="cell" class="mono" data-h="Assembly">
                  {l.assy}
                </td>
                <td role="cell" class="chk">
                  <label class="chk-hit">
                    <input
                      type="checkbox"
                      class="fault-check"
                      data-kind="lamp"
                      data-id={l.id}
                      aria-label={`Fault: ${l.name}`}
                    />
                  </label>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <section class="card lamps">
    <h2>Installed flashers</h2>
    <p class="muted small">
      The flasher LEDs from the same kit, as its sheet groups them. The flashers themselves are on
      the <a href={href('coils')}>solenoids page</a>.
    </p>
    <div class="scroll-x">
      <table class="t">
        <thead>
          <tr><th>Where</th><th>Installed</th></tr>
        </thead>
        <tbody>
          {
            INSTALLED_FLASHERS.map((f) => (
              <tr>
                <td>{f.where}</td>
                <td class="mono">{f.led}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>
</Base>

<script>
  import '~/lib/fault-check';
</script>

<style>
  .lamps {
    margin-top: var(--gap);
  }
</style>
