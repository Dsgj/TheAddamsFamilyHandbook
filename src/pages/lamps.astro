---
import Base from '~/layouts/Base.astro';
import ComponentTable from '~/components/ComponentTable.astro';
import Matrix from '~/components/Matrix.svelte';
import { DATA } from '~/lib/data/components';
import { INSTALLED_FLASHERS, LED_KIT_SOURCE } from '~/data/installedLeds';
import { KIND_PLURAL, TABLE_LABEL, matrixSpan } from '~/lib/copy';
import { matrixCells } from '~/lib/matrix';
import { pageTitleText } from '~/lib/pages';
import { mono } from '~/lib/table';
import type { Column, Row } from '~/lib/table';
import { href, manualHref } from '~/lib/url';

const cells = matrixCells(DATA.lamps);
/** The All lamps table: the LED fitted here, the manual's bulb type and part, and the assembly. */
const LAMP_COLUMNS: Column[] = [
  { head: 'Installed' },
  { head: 'Bulb' },
  { head: 'Part' },
  { head: 'Assembly' },
];
const lampRows: Row[] = DATA.lamps.map((l) => ({
  id: l.id,
  name: l.name,
  note: l.speaker ? 'speaker panel' : undefined,
  muted: l.unused,
  cells: [mono(l.led), mono(l.bulb), mono(l.bulbPart), mono(l.assy)],
}));
const cols = matrixSpan(DATA.lCols);
const rows = matrixSpan(DATA.lRows);
---

<Base
  title={TABLE_LABEL.lamp}
  short={KIND_PLURAL.lamp}
  nav="lamps"
  description="The lamp matrix with bulb numbers and a Fault tick per lamp."
>
  <h1>Lamp matrix</h1>
  <p class="muted">
    Columns from {cols.connectors} ({cols.drivers}), rows from {rows.connectors} ({rows.drivers}),
    all on the power driver board. Source:{' '}
    <a href={manualHref('ops', 104)}>Lamp Matrix {pageTitleText('ops', 104)}</a>. Lamps marked
    speaker sit in the speaker panel, not on the playfield.
  </p>
  <Matrix client:load kind="lamp" cells={cells} cols={DATA.lCols} rows={DATA.lRows} />

  <section class="card lamps">
    <h2>All lamps</h2>
    <p class="muted small">
      Tick Fault to put the lamp on the <a href={href('shopping')}>shopping list</a> with the LED to order.
      It turns red in the matrix and on the map. Installed is the LED fitted in this machine ({
        LED_KIT_SOURCE
      }); Bulb is the manual's socket type.
    </p>
    <ComponentTable kind="lamp" columns={LAMP_COLUMNS} rows={lampRows} />
  </section>

  <section class="card lamps">
    <h2>Installed flashers</h2>
    <p class="muted small">
      The flasher LEDs from the same kit, as its sheet groups them; the flashers are on{' '}
      <a href={href('coils')}>{TABLE_LABEL.coil}</a>.
    </p>
    <div class="scroll-x">
      <table class="t">
        <thead>
          <tr><th>Where</th><th>Installed</th></tr>
        </thead>
        <tbody>
          {
            INSTALLED_FLASHERS.map((f) => (
              <tr>
                <td>{f.where}</td>
                <td class="mono">{f.led}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>
</Base>

<script>
  import '~/lib/fault-check';
</script>

<style>
  .lamps {
    margin-top: var(--gap);
  }
</style>
