---
import Icon from '~/components/Icon.astro';
import Base from '~/layouts/Base.astro';
import DocSeg from '~/components/DocSeg.astro';
import HandbookToc from '~/components/HandbookToc.svelte';
import { handbookToc } from '~/lib/handbook/toc';
import { SECTIONS } from '~/lib/handbook/sections';
import { pageLabel } from '~/lib/pages';
import { APPENDICES, appendixHref } from '~/data/appendix';
import { handbookHref, href, manualHref } from '~/lib/url';

/**
 * The Handbook home (spec §9.10): the segmented links, the search field, Continue reading (filled
 * from `tafh:reading` by the page script), the operator's section list and the handbook appendix.
 */
const toc = await handbookToc();
const manual = SECTIONS.filter((s) => s.key !== 'appendix');
/** "1-15 – 1-19" for a contiguous run of labelled pages; "A – F" for the shot maps; else nothing.
 * Narrow no-break spaces set the dash apart: in the mono face it was barely wider than the labels'
 * hyphens, and '1-1–1-6' read as one code (VP2-17). */
const range = (pages: number[]): string => {
  const first = pages[0]!;
  const last = pages.at(-1)!;
  if (last - first !== pages.length - 1) return '';
  const a = pageLabel('ops', first);
  const b = pageLabel('ops', last);
  return a && b ? (a === b ? a : `${a}\u202f–\u202f${b}`) : '';
};
---

<Base
  title="Handbook"
  nav="handbook"
  h1="large"
  description="The Operations Manual transcribed section by section, plus a handbook appendix of notes for this machine."
>
  <div class="hub" data-hub="handbook">
    <DocSeg current="handbook" />
    <HandbookToc client:load items={toc} home />

    <section class="cont" hidden data-continue>
      <h2 class="lst-h">Continue reading</h2>
      <ul class="lst">
        <li>
          <a class="lrow two" href={href('handbook')}>
            <span class="txt">
              <span class="ttl" data-ttl></span>
              <span class="sub" data-sub></span>
            </span>
            <Icon name="forward" class="chev" />
          </a>
        </li>
      </ul>
    </section>

    <h2 class="lst-h">Operations Manual, operator's section</h2>
    <ul class="lst">
      {
        manual.map((s) => (
          <li>
            <a class="lrow" href={handbookHref(s.key)}>
              <span class="txt">
                <span class="ttl">{s.title}</span>
              </span>
              {range(s.pages) && <span class="val mono">{range(s.pages)}</span>}
              <Icon name="forward" class="chev" />
            </a>
          </li>
        ))
      }
    </ul>
    <p class="gf">
      Pages 1-16 to 1-18 are transcribed from a hard-to-read manual page and not yet verified. Parts
      (section 2) and schematics (section 3) are not transcribed; open them in <a
        href={manualHref('ops', 59)}>the manual viewer</a
      >.
    </p>

    <h2 class="lst-h">Handbook appendix</h2>
    <ul class="lst">
      {
        Object.entries(APPENDICES).map(([code, title]) => (
          <li>
            <a class="lrow" href={appendixHref(code)}>
              <span class="code dmd">{code}</span>
              <span class="txt">
                <span class="ttl">{title}</span>
              </span>
              <Icon name="forward" class="chev" />
            </a>
          </li>
        ))
      }
    </ul>
    <p class="gf">Notes written for this machine, not manual text.</p>
  </div>
</Base>

<script>
  import { READING_KEY, readReading } from '~/lib/model/reading';
  import { watch } from '~/lib/storage';
  import { handbookHref } from '~/lib/url';

  // Continue reading: the last page the reader scrolled to, if any. Drawn again when another tab
  // changes it and when the page comes back from the back/forward cache, so Clear all hides it.
  const sec = document.querySelector<HTMLElement>('[data-continue]');
  const render = () => {
    const r = readReading();
    if (!sec) return;
    if (r) {
      const a = sec.querySelector<HTMLAnchorElement>('a.lrow')!;
      a.href = handbookHref(r.section, r.anchor);
      sec.querySelector('[data-ttl]')!.textContent = r.title;
      sec.querySelector('[data-sub]')!.textContent = r.label;
    }
    sec.hidden = !r;
  };
  render();
  watch(READING_KEY, render);
</script>

<style>
  /* Inside the hub (VL3-09) the lists, headings and footnote keep their 16 margins, like Workshop's. */
  .lrow .code {
    flex: 0 0 auto;
    min-width: 40px;
    text-align: center;
  }
</style>
