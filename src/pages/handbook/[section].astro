---
import { getCollection } from 'astro:content';
import Base from '~/layouts/Base.astro';
import HandbookToc from '~/components/HandbookToc.svelte';
import PlayfieldMap from '~/components/PlayfieldMap.svelte';
import ReaderBar from '~/components/ReaderBar.svelte';
import { SECTIONS, isAppendixPage } from '~/lib/handbook/sections';
import { handbookToc } from '~/lib/handbook/toc';
import { pageLabel, pageTitleText, printedPageText } from '~/lib/pages';
import { handbookHref, manualHref } from '~/lib/url';
import { APPENDICES, appendixHref } from '~/data/appendix';
import { OWNER_NOTES } from '~/data/ownerNotes';

/**
 * The Handbook reader (spec §9.11): one section per page, the back link "Handbook", "View the
 * manual page" in the bar, and the bottom toolbar (ReaderBar). The reader pages by section (Q17); the
 * toolbar's ends carry the nearest page label of the adjacent section.
 */
export async function getStaticPaths() {
  return SECTIONS.map((s) => ({ params: { section: s.key }, props: { section: s } }));
}
const { section } = Astro.props;
const entries = (await getCollection('handbook', (e) => e.data.section === section.key)).sort(
  (a, b) => a.data.order - b.data.order,
);
const toc = await handbookToc();
const i = SECTIONS.indexOf(section);
const prev = SECTIONS[i - 1];
const next = SECTIONS[i + 1];
const end = (s: typeof section | undefined, page: number | undefined) =>
  s && page !== undefined
    ? {
        href: handbookHref(s.key),
        label: isAppendixPage(page) ? 'Appendix' : pageLabel('ops', page) || s.title,
        title: s.title,
      }
    : undefined;
const prevEnd = end(prev, prev?.pages.at(-1));
const nextEnd = end(next, next?.pages[0]);
const UNVERIFIED = new Set([26, 27, 28]);
const scan = section.key === 'appendix' ? undefined : manualHref('ops', section.pages[0]!);
const description =
  section.key === 'appendix'
    ? 'The handbook appendix: notes written for this machine, each naming its sources.'
    : `${section.title}: a section of the handbook, transcribed from the Operations Manual.`;
---

<Base
  title={section.title}
  short={section.short}
  nav="handbook"
  back={{ path: 'handbook', label: 'Handbook' }}
  description={description}
>
  {
    scan && (
      <a
        slot="actions"
        class="ibtn"
        href={scan}
        aria-label="View the manual page"
        title="View the manual page"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <rect x="5" y="3" width="14" height="18" rx="2" />
          <path d="M9 8h6M9 12h6M9 16h4" />
        </svg>
      </a>
    )
  }
  <script is:inline>
    try {
      const t = localStorage.getItem('tafh:text');
      if (t === 'sm' || t === 'lg') document.documentElement.dataset.text = t;
    } catch {
      /* no storage: the default size */
    }
  </script>
  <div class="hb">
    <aside class="side">
      <details class="card" open>
        <summary>Contents</summary>
        <HandbookToc client:load items={toc} current={section.key} />
      </details>
    </aside>
    <article class="prose" data-section={section.key} data-title={section.title}>
      <h1>{section.title}</h1>
      {
        section.key === 'appendix' && (
          <p class="prov warn">
            These pages are notes written for this machine, not manual text. Each one names its
            sources. Values marked forum come from one thread and are not verified; measure before
            you trust them.
          </p>
        )
      }
      {
        entries.map((e) => (
          <section id={`pg-${e.data.page}`}>
            <div class="pg-bar">
              {/* The marker says the page once; the Manual button carries it in its name only. */}
              <span class="mono" aria-hidden={isAppendixPage(e.data.page) ? undefined : 'true'}>
                {isAppendixPage(e.data.page)
                  ? `Appendix ${e.data.label}`
                  : printedPageText(e.data.label, e.data.page)}
              </span>
              {UNVERIFIED.has(e.data.page) && (
                <span class="st-untested">transcription not verified</span>
              )}
              {isAppendixPage(e.data.page) ? (
                <span class="small muted">owner's note</span>
              ) : (
                <a
                  class="btn sm"
                  href={manualHref('ops', e.data.page)}
                  aria-label={`Manual ${pageTitleText('ops', e.data.page)}`}
                >
                  Manual
                </a>
              )}
            </div>
            <Fragment set:html={e.rendered?.html ?? ''} />
            {e.data.page === 9 && (
              <div class="shot-map">
                <p class="small muted">
                  Both shot maps (p. E–F) on one drawing. Tap a letter; switch on the other layers
                  to see the switches, lamps and coils under each shot.
                </p>
                <PlayfieldMap client:visible layer="shot" embed />
              </div>
            )}
            {!isAppendixPage(e.data.page) &&
              OWNER_NOTES[e.data.page]?.map((n) => (
                <aside class="owner-note small" role="note" aria-label="Owner's note">
                  <span class="muted">Owner's note:</span> {n.text}{' '}
                  <a href={appendixHref(n.code)}>
                    {n.code} {APPENDICES[n.code]}
                  </a>
                </aside>
              ))}
          </section>
        ))
      }
    </article>
  </div>
  <ReaderBar client:load prev={prevEnd} next={nextEnd} items={toc} current={section.key} />
</Base>

<script>
  import { saveReading } from '~/lib/model/reading';
  import { nowIso } from '~/lib/status-io';

  // Continue reading: remember the page whose bar last crossed the upper part of the viewport.
  const art = document.querySelector<HTMLElement>('article[data-section]');
  if (art) {
    const section = art.dataset.section ?? '';
    const title = art.dataset.title ?? '';
    const record = (sec: HTMLElement) => {
      const label = sec.querySelector('.pg-bar .mono')?.textContent?.trim() ?? '';
      saveReading({ section, title, anchor: sec.id, label, at: nowIso() });
    };
    const pages = [...art.querySelectorAll<HTMLElement>('section[id^="pg-"]')];
    if (pages[0]) record(pages[0]);
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (es) => {
          for (const e of es) if (e.isIntersecting) record(e.target as HTMLElement);
        },
        { rootMargin: '-30% 0px -60% 0px' },
      );
      pages.forEach((p) => io.observe(p));
    }
  }
</script>

<style>
  .owner-note {
    border-left: 2px solid var(--brass);
    padding-left: 10px;
    margin: 8px 0 12px;
  }
  .hb {
    display: grid;
    gap: var(--gap);
    /* minmax(0,1fr), not 1fr: a plain 1fr track is minmax(auto,1fr), so a wide table (or figure)
       sets the column's minimum to its own min-content width and blows the page out past the
       viewport (VP-01, AY-03). */
    grid-template-columns: minmax(0, 1fr);
    /* Room for the fixed reader toolbar. */
    padding-bottom: 72px;
  }
  .side {
    display: none;
  }
  @media (min-width: 960px) {
    .hb {
      grid-template-columns: 300px minmax(0, 1fr);
    }
    .side {
      display: block;
      position: sticky;
      top: calc(var(--safe-top) + var(--topbar-h) + 40px);
      align-self: start;
    }
  }
  /* The Contents heading keeps its display face, like the manual card heads (.mhead). It is a 44
     target (audit AY-12): a 44 line, so the disclosure marker stays (display: flex drops it). */
  summary {
    cursor: pointer;
    font: var(--t-head);
    font-family: var(--font-display);
    font-weight: 400;
    min-height: 44px;
    line-height: 44px;
  }
</style>
