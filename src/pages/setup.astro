---
import Base from '~/layouts/Base.astro';
import SetupGuide from '~/components/SetupGuide.svelte';
import { FACTORY_RESET_WARNING, SETUP_INTRO, SETUP_STEPS } from '~/data/setup';
import { findHeading, type HeadingIndex } from '~/lib/handbook/render';
import { handbookToc } from '~/lib/handbook/toc';
import { href } from '~/lib/url';

/** Resolve each item to its heading in the Handbook the way `#find:` links do; section as fallback. */
const toc = await handbookToc();
const idx: HeadingIndex = new Map(
  toc
    .filter((t) => t.level > 1)
    .map((t) => [t.id, { id: t.id, level: t.level === 2 ? 2 : 3, text: t.text, page: t.page }]),
);
const sectionOf = new Map(toc.map((t) => [t.id, t.section]));
const links: Record<string, string> = {};
for (const s of SETUP_STEPS) {
  for (const i of s.items) {
    const code = i.find ?? i.id;
    if (!code) continue;
    const h = findHeading(idx, code);
    if (h) links[i.id] = href(`handbook/${sectionOf.get(h.id)}#${h.id}`);
  }
}
---

<Base
  title="Machine setup"
  nav="setup"
  description="Every adjustment, preset and utility to set after a move or a reset, as a guided checklist with the values recorded on this device."
>
  <h1>Machine setup</h1>
  <SetupGuide
    client:load
    steps={SETUP_STEPS}
    links={links}
    intro={SETUP_INTRO}
    warning={FACTORY_RESET_WARNING}
  />
  <p class="muted small">
    Values and ticks stay on this device and go into the backup on the
    <a href={href('shopping')}>Shopping list</a> page. The advice lives in <code
      >src/data/setup.ts</code
    >; the full option lists are in the Handbook under <a href={href('handbook/adjustments')}
      >Adjustments</a
    >, <a href={href('handbook/presets')}>Difficulty & presets</a> and <a
      href={href('handbook/utilities')}>Utilities</a
    >.
  </p>
</Base>
