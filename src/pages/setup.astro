---
import Base from '~/layouts/Base.astro';
import SetupGuide from '~/components/SetupGuide.svelte';
import { FACTORY_RESET_WARNING, SETUP_INTRO, SETUP_STEPS } from '~/data/setup';
import { headingHref } from '~/lib/handbook/links';
import { findHeading } from '~/lib/handbook/render';
import { handbookIndex } from '~/lib/handbook/toc';
import { handbookHref, href } from '~/lib/url';

/**
 * Resolve each item to its heading in the Handbook the way `#find:` links do; section as fallback.
 * The advice itself lives in src/data/setup.ts.
 */
const idx = await handbookIndex();
const links: Record<string, string> = {};
for (const s of SETUP_STEPS) {
  for (const i of s.items) {
    const code = i.find ?? i.id;
    if (!code) continue;
    const h = findHeading(idx.headings, code);
    if (h) links[i.id] = headingHref(idx, h);
  }
}
---

<Base
  title="Machine setup"
  nav="setup"
  description="Every adjustment, preset and utility to set after a move or a reset, as a guided checklist with the values recorded on this device."
>
  <h1>Machine setup</h1>
  <SetupGuide
    client:load
    steps={SETUP_STEPS}
    links={links}
    intro={SETUP_INTRO}
    warning={FACTORY_RESET_WARNING}
  />
  <p class="muted small">
    Values and ticks stay on this device and go into the backup on the{' '}
    <a href={href('shopping')}>Shopping list</a> page. The full option lists are in the handbook under{
      ' '
    }
    <a href={handbookHref('adjustments')}>Adjustments</a>,{' '}
    <a href={handbookHref('utilities')}>Utilities</a> and{' '}
    <a href={handbookHref('presets')}>Difficulty and presets</a>.
  </p>
</Base>
