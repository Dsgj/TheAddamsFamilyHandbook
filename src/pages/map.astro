---
import Base from '~/layouts/Base.astro';
import PlayfieldMap from '~/components/PlayfieldMap.svelte';
---

<Base
  title="Playfield map"
  short="Map"
  nav="map"
  h1="bar"
  fullbleed
  description="The playfield drawing with every switch, lamp, solenoid and shot, searchable and linked to the tables."
>
  <Fragment slot="actions">
    <button class="ibtn" type="button" aria-label="Search components" data-map="find">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="11" cy="11" r="7"></circle><path d="M20 20l-4-4"></path>
      </svg>
    </button>
    <button
      class="ibtn narrow"
      type="button"
      aria-label="All components on the map"
      aria-haspopup="dialog"
      data-map="parts"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
  </Fragment>
  <script is:inline>
    // Before the map is parsed, so before its first paint (PF2-01): the canvas's CSS fit takes what
    // hydration will apply, so it lands without a jump: the zoom the URL restores (?z=, at most
    // MAX_ZOOM 3) and, below 600, the selection sheet's peek (PEEK 96) that a selected part (?id=)
    // opens under the drawing.
    (function () {
      const u = new URLSearchParams(location.search);
      const root = document.documentElement.style;
      const z = Math.min(Number(u.get('z')) || 1, 3);
      if (z > 1) root.setProperty('--map-z', String(z));
      const sheet = u.get('id') && !u.has('calib') && matchMedia('(max-width: 999px)').matches;
      if (sheet && matchMedia('(max-width: 599px)').matches)
        root.setProperty('--map-inset', '96px');
      // A page that opens with the sheet up arrives without the cross-fade: that view transition
      // crashed WebKit (Playwright's, a Map tab back to a selected part). BottomSheet skips the
      // one out of it.
      if (sheet)
        addEventListener('pagereveal', function (e) {
          if (e.viewTransition) e.viewTransition.skipTransition();
        });
    })();
  </script>
  <PlayfieldMap client:load />
</Base>

<style>
  /* From 1000 the side panel holds the list (spec §6.5). */
  @media (min-width: 1000px) {
    .narrow {
      display: none;
    }
  }
</style>

<script>
  import { emit } from '~/lib/events';

  // The bar's buttons talk to the PlayfieldMap island through one app event.
  for (const b of document.querySelectorAll<HTMLButtonElement>('button[data-map]'))
    b.addEventListener('click', () => emit('map', b.dataset.map ?? ''));
</script>
