---
import Icon from '~/components/Icon.astro';
import Base from '~/layouts/Base.astro';
import PlayfieldMap from '~/components/PlayfieldMap.svelte';
import { inlineScript } from '~/lib/inline-script';
import mapSrc from '~/inline/map.js?raw';
import { PHONE, WIDE } from '~/lib/bp';
import { SHEET_PEEK } from '~/lib/map/fit';
import { MAX_ZOOM } from '~/lib/map/zoom-math';
---

<Base
  title="Playfield map"
  short="Map"
  nav="map"
  h1="bar"
  back="context"
  fullbleed
  description="The playfield drawing with every switch, lamp, solenoid and shot, searchable and linked to the tables."
>
  <Fragment slot="actions">
    <button class="ibtn" type="button" aria-label="Search components" data-map="find">
      <Icon name="search" />
    </button>
    <button
      class="ibtn narrow"
      type="button"
      aria-label="All components on the map"
      aria-haspopup="dialog"
      data-map="parts"
    >
      <Icon name="menu" />
    </button>
  </Fragment>
  {
    /* Before the map is parsed (PF2-01): src/inline/map.js, with the zoom cap, the sheet's peek
      and the queries it matches from their modules (AR3-03). */
  }
  <script
    is:inline
    data-max-zoom={MAX_ZOOM}
    data-peek={SHEET_PEEK}
    data-wide={WIDE}
    data-phone={PHONE}
    set:html={inlineScript(mapSrc)}
  />
  <PlayfieldMap client:load />
</Base>

<style>
  /* From 1000 the side panel holds the list (spec §6.5). */
  @media (min-width: 1000px) {
    .narrow {
      display: none;
    }
  }
</style>

<script>
  import { emit } from '~/lib/events';

  // The bar's buttons talk to the PlayfieldMap island through one app event.
  for (const b of document.querySelectorAll<HTMLButtonElement>('button[data-map]'))
    b.addEventListener('click', () => emit('map', b.dataset.map ?? ''));
</script>
