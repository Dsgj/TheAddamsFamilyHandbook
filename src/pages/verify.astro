---
import Base from '~/layouts/Base.astro';
import { VERIFY_ITEMS as ITEMS } from '~/data/verify';
const groups = [...new Set(ITEMS.map((i) => i.group))];
---

<Base
  title="Verify"
  nav="verify"
  description="Open questions in the data that need a look at the real machine, as a checklist."
>
  <h1>Verify in the machine</h1>
  <p class="muted">
    Places where the manual, the parts list and the scans disagree, or where the data was placed by
    hand. Tick an item when you have checked it on the machine. Ticks stay on this device.{' '}
    <span class="mono" data-verify-count></span>
  </p>
  {
    groups.map((g) => (
      <section class="card">
        <h2>{g}</h2>
        <ul class="checks">
          {ITEMS.filter((i) => i.group === g).map((i) => (
            <li>
              <label>
                <input type="checkbox" class="verify-check" data-id={i.id} />
                <span class="text">{i.text}</span>
              </label>
              <p class="links small">
                {i.links.map(([label, url]) => (
                  <a href={url}>{label}</a>
                ))}
                <span class="when muted" />
              </p>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
  <p class="muted small">
    Source: <code>kit-docs/KNOWN-ISSUES.md</code>. When an item is settled, correct the data and
    remove it there and here.
  </p>
</Base>

<style>
  .card {
    margin-top: var(--gap);
  }
  .checks {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .checks li {
    padding: 4px 0;
    border-top: 1px solid var(--line);
  }
  .checks li:first-child {
    border-top: 0;
  }
  /* Rows are at least 44px tall with a 44px tick target (spec §8.3). */
  .checks label {
    display: grid;
    grid-template-columns: var(--touch) 1fr;
    align-items: center;
    min-height: 44px;
    gap: 4px;
    cursor: pointer;
  }
  .checks input {
    width: 22px;
    height: 22px;
    margin: 0 auto;
    accent-color: var(--ok);
  }
  .checks label:active {
    background: var(--press);
  }
  .checks li.done .text {
    color: var(--muted);
    text-decoration: line-through;
    text-decoration-color: var(--ok);
  }
  /* Spec §12: the source links are a list under the label, so each is a real 44 × 44 target; a tap
     beside one never reaches the tick above. */
  .links {
    margin: 0 0 0 var(--touch);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 14px;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--touch);
    min-width: var(--touch);
  }
</style>

<script>
  import '~/lib/verify-check';
</script>
