---
import Base from '~/layouts/Base.astro';
import { VERIFY_ITEMS as ITEMS } from '~/data/verify';
const groups = [...new Set(ITEMS.map((i) => i.group))];
---

<Base
  title="Verify"
  nav="verify"
  description="Open questions in the data that need a look at the real machine, as a checklist."
>
  <h1>Verify in the machine</h1>
  <p class="muted">
    Places where the manual, the parts list and the scans disagree, or where the data was placed by
    hand. Tick an item when you have checked it on the machine. Ticks stay on this device.
    <span class="mono" data-verify-count></span>
  </p>
  {
    groups.map((g) => (
      <section class="card">
        <h2>{g}</h2>
        <ul class="checks">
          {ITEMS.filter((i) => i.group === g).map((i) => (
            <li>
              <label>
                <input type="checkbox" class="verify-check" data-id={i.id} />
                <span class="text">{i.text}</span>
              </label>
              <p class="links small">
                {i.links.map(([label, url]) => (
                  <a href={url}>{label}</a>
                ))}
                <span class="when muted" />
              </p>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
  <p class="muted small">
    Source: <code>kit-docs/KNOWN-ISSUES.md</code>. When an item is settled, correct the data and
    remove it there and here.
  </p>
</Base>

<style>
  .card {
    margin-top: var(--gap);
  }
  .checks {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .checks li {
    padding: 10px 0;
    border-top: 1px solid var(--line);
  }
  .checks li:first-child {
    border-top: 0;
  }
  .checks label {
    display: grid;
    grid-template-columns: var(--touch) 1fr;
    align-items: start;
    gap: 4px;
    cursor: pointer;
  }
  .checks input {
    width: 22px;
    height: 22px;
    margin: 2px auto;
    accent-color: var(--ok);
  }
  .checks li.done .text {
    color: var(--muted);
    text-decoration: line-through;
    text-decoration-color: var(--ok);
  }
  .links {
    margin: 4px 0 0 var(--touch);
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
  }
</style>

<script>
  import '~/lib/verify-check';
</script>
