---
import Codes from '~/components/Codes.astro';
import Progress from '~/components/Progress.svelte';
import Base from '~/layouts/Base.astro';
import { VERIFY_ITEMS as ITEMS } from '~/data/verify';
const groups = [...new Set(ITEMS.map((i) => i.group))];
// Source: kit-docs/KNOWN-ISSUES.md. When an item is settled, correct the data and remove it there
// and in src/data/verify.ts.
---

<Base
  title="Verify"
  nav="verify"
  description="Open questions in the data that need a look at the real machine, as a checklist."
>
  <h1>Verify</h1>
  <p class="muted">
    Places where the manual's pages and its parts list disagree, or where the data was placed by
    hand. Tick an item once you have checked it on the machine; ticks stay on this device.
  </p>
  <Progress done={0} total={ITEMS.length} what="verified" data-verify-count="" />
  {
    groups.map((g) => (
      <section class="card">
        <h2>{g}</h2>
        <ul class="checklist">
          {ITEMS.filter((i) => i.group === g).map((i) => (
            <li>
              <label class="tick">
                <input type="checkbox" class="verify-check" id={`verify-${i.id}`} data-id={i.id} />
              </label>
              <div class="body">
                <label class="text title" for={`verify-${i.id}`}>
                  <Codes text={i.text} />
                </label>
                <p class="links small">
                  {i.links.map(([label, url]) => (
                    <a href={url}>{label}</a>
                  ))}
                  <span class="when muted" />
                </p>
              </div>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Base>

<style>
  .card {
    margin-top: var(--gap);
  }
  /* The row is the shared checklist row (lists.css, VP2-05); the statement is its title, a click on
     it ticks the box. */
  .text {
    display: block;
    cursor: pointer;
  }
</style>

<script>
  import '~/lib/verify-check';
</script>
