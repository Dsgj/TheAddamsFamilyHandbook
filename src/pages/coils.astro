---
import Base from '~/layouts/Base.astro';
import Phrase from '~/components/Phrase.astro';
import WireChip from '~/components/WireChip.svelte';
import { FLASHERS } from '~/data/verify';
import { DATA } from '~/lib/data/components';
import { KIND_PLURAL, TABLE_LABEL } from '~/lib/copy';
import { pageRefText, pageTitleText } from '~/lib/pages';
import { componentHref, href, manualHref } from '~/lib/url';

const groups = ['High Power', 'Low Power', 'Flasher'] as const;
---

<Base
  title={TABLE_LABEL.coil}
  short={KIND_PLURAL.coil}
  nav="coils"
  description="Solenoids, flashers and flipper coils with wire colours, drivers and a Fault tick each."
>
  <h1>Solenoids and flashers</h1>
  <p class="muted">
    Source: <a href={manualHref('ops', 108)}>Solenoid/Flasher Table {pageTitleText('ops', 108)}</a> and{
      ' '
    }
    <a href={manualHref('ops', 2)}>{pageRefText('ops', 2)}</a>. The fuse column is derived from the
    fuse list on {pageTitleText('ops', 57)}, not printed per coil, except the magnets 16, 23 and 24,
    whose 5A S.B. fuse is printed in a footnote on {pageTitleText('ops', 2)}. The table lists{' '}
    {FLASHERS.table} flasher bulbs; the parts list sums to {FLASHERS.parts}. The manual does not say
    which count is right, so{' '}
    <a href={href('verify#verify-flasher-count')}>Verify</a> asks you to count them in the machine.
  </p>

  {
    groups.map((g) => (
      <section class="card grp">
        <h2>{g}</h2>
        <div class="scroll-x">
          <table class="t two" role="table">
            <thead role="rowgroup">
              <tr role="row">
                <>
                  <th role="columnheader" class="key">
                    #
                  </th>
                  <th role="columnheader">Name</th>
                  <th role="columnheader">Wire</th>
                  <th role="columnheader">Pin</th>
                  <th role="columnheader">Driver</th>
                  <th role="columnheader">Coil</th>
                  <th role="columnheader">Fuse</th>
                  <th role="columnheader">
                    <span class="sr-only">Location</span>
                  </th>
                  <th role="columnheader" class="chk">
                    Fault
                  </th>
                </>
              </tr>
            </thead>
            <tbody role="rowgroup">
              {DATA.coils
                .filter((c) => c.type === g)
                .map((c) => (
                  <tr role="row" id={`coil-${c.id}`}>
                    <td role="cell" class="key">
                      <a class="mono" href={componentHref('coil', c.id)}>
                        {c.id}
                      </a>
                    </td>
                    <td role="cell" class="nm">
                      {c.name}
                      {c.note && (
                        <span class="note muted small">
                          <span class="sep"> · </span>
                          {c.note}
                        </span>
                      )}
                    </td>
                    <td role="cell" data-h="Wire">
                      <WireChip colour={c.wireEn} />
                    </td>
                    <td role="cell" class="mono phrase" data-h="Pin">
                      <Phrase text={c.pin} />
                    </td>
                    <td role="cell" class="mono" data-h="Driver">
                      {c.driver}
                    </td>
                    <td role="cell" class="mono phrase" data-h="Coil">
                      <Phrase text={c.part} />
                    </td>
                    <td role="cell" class="mono small phrase fuse" data-h="Fuse">
                      <a href={href(`fuses#${c.fuseKey}`)}>
                        <Phrase text={c.fuse} />
                      </a>
                    </td>
                    <td role="cell" class="muted small" data-h="Location">
                      {c.cabinet ? 'in cabinet' : c.under ? 'under playfield' : ''}
                    </td>
                    <td role="cell" class="chk">
                      <label class="chk-hit">
                        <input
                          type="checkbox"
                          class="fault-check"
                          data-kind="coil"
                          data-id={c.id}
                          aria-label={`Fault: ${c.name}`}
                        />
                      </label>
                    </td>
                  </tr>
                ))}
            </tbody>
          </table>
        </div>
      </section>
    ))
  }

  <div class="pair">
    <section class="card">
      <h2 id="flippers">Flipper coils</h2>
      <div class="scroll-x">
        <table class="t two" role="table">
          <thead role="rowgroup">
            <tr role="row">
              <th role="columnheader" class="key">#</th>
              <th role="columnheader">Name</th>
              <th role="columnheader">Wire</th>
              <th role="columnheader">Pin</th>
              <th role="columnheader">Coil</th>
              <th role="columnheader">Assembly</th>
              <th role="columnheader">Fuse</th>
            </tr>
          </thead>
          <tbody role="rowgroup">
            {
              DATA.flippers.map((f) => (
                <tr role="row">
                  <td role="cell" class="key mono">
                    {f.id}
                  </td>
                  <td role="cell" class="nm">
                    {f.name}
                  </td>
                  <td role="cell" data-h="Wire">
                    <WireChip colour={f.wire} />
                  </td>
                  <td role="cell" class="mono phrase" data-h="Pin">
                    <Phrase text={f.pin} />
                  </td>
                  <td role="cell" class="mono phrase" data-h="Coil">
                    <Phrase text={f.coil} />
                  </td>
                  <td role="cell" class="mono phrase" data-h="Assembly">
                    <Phrase text={f.assy} />
                  </td>
                  <td role="cell" class="small fuse" data-h="Fuse">
                    <a href={href(`fuses#${f.fuseKey}`)}>{f.fuse}</a>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="prov">
        Upper flippers are fed by the Extra Flipper Supply Board (F901/F902). Source: <a
          href={manualHref('ops', 112)}>Flipper Circuits {pageTitleText('ops', 112)}</a
        >.
      </p>
    </section>
    <section class="card">
      <h2 id="gi">General illumination</h2>
      <div class="scroll-x">
        <table class="t two" role="table">
          <thead role="rowgroup">
            <tr role="row">
              <th role="columnheader" class="key">String</th>
              <th role="columnheader">Name</th>
              <th role="columnheader">Wire</th>
              <th role="columnheader">Pin</th>
              <th role="columnheader">Triac</th>
              <th role="columnheader">Bulb</th>
              <th role="columnheader">Fuse</th>
            </tr>
          </thead>
          <tbody role="rowgroup">
            {
              DATA.gi.map((g) => (
                <tr role="row">
                  <td role="cell" class="key mono">
                    {g.id}
                  </td>
                  <td role="cell" class="nm">
                    {g.name}
                  </td>
                  <td role="cell" data-h="Wire">
                    <WireChip colour={g.wire} />
                  </td>
                  <td role="cell" class="mono phrase" data-h="Pin">
                    <Phrase text={g.pin} />
                  </td>
                  <td role="cell" class="mono" data-h="Triac">
                    {g.driver}
                  </td>
                  <td role="cell" class="mono phrase" data-h="Bulb">
                    <Phrase text={g.bulb} />
                  </td>
                  <td role="cell" class="small fuse" data-h="Fuse">
                    <a href={href(`fuses#${g.fuseKey}`)}>{g.fuse}</a>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>
  </div>
</Base>

<script>
  import '~/lib/fault-check';
</script>

<style>
  .grp {
    margin-bottom: var(--gap);
  }
  /* The row a link names (`/coils#coil-01`, UX2-07). */
  tr:target > td {
    background: color-mix(in srgb, var(--amber) 16%, transparent);
  }
  /* Spec §8.9: the flipper and GI tables stack at every width. Side by side they scrolled at 1000
     and broke their part numbers at 1440 (VP-05). */
  .pair {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--gap);
  }
</style>
