---
import Base from '~/layouts/Base.astro';
import ComponentTable from '~/components/ComponentTable.astro';
import { FLASHERS } from '~/data/verify';
import { DATA } from '~/lib/data/components';
import { KIND_PLURAL, TABLE_LABEL } from '~/lib/copy';
import { pageRefText, pageTitleText } from '~/lib/pages';
import { fuse, mono, muted, phrase, wire } from '~/lib/table';
import type { Column, Row } from '~/lib/table';
import { href, manualHref, rowAnchor, verifyHref } from '~/lib/url';

const groups = ['High Power', 'Low Power', 'Flasher'] as const;
/** The group headings in sentence case, like the page's other headings (CP3-08). */
const GROUP_HEADING: Record<(typeof groups)[number], string> = {
  'High Power': 'High power',
  'Low Power': 'Low power',
  Flasher: 'Flashers',
};

/** The solenoid and flasher tables: driver, coil and fuse, and where it sits (a heading for screen readers). */
const COIL_COLUMNS: Column[] = [
  { head: 'Wire' },
  { head: 'Pin' },
  { head: 'Driver' },
  { head: 'Coil' },
  { head: 'Fuse' },
  { head: 'Location', sr: true },
];
const coilRows = (type: (typeof groups)[number]): Row[] =>
  DATA.coils
    .filter((c) => c.type === type)
    .map((c) => ({
      id: c.id,
      name: c.name,
      note: c.note,
      anchor: rowAnchor('coil', c.id),
      cells: [
        wire(c.wire),
        phrase(c.pin),
        mono(c.driver),
        phrase(c.part),
        fuse(c.fuse, c.fuseKey),
        muted(c.cabinet ? 'in cabinet' : c.under ? 'under playfield' : ''),
      ],
    }));
const FLIPPER_COLUMNS: Column[] = [
  { head: 'Wire' },
  { head: 'Pin' },
  { head: 'Coil' },
  { head: 'Assembly' },
  { head: 'Fuse' },
];
const flipperRows: Row[] = DATA.flippers.map((f) => ({
  id: f.id,
  name: f.name,
  anchor: rowAnchor('flipper', f.id),
  cells: [wire(f.wire), phrase(f.pin), phrase(f.coil), phrase(f.assy), fuse(f.fuse, f.fuseKey)],
}));
const GI_COLUMNS: Column[] = [
  { head: 'Wire' },
  { head: 'Pin' },
  { head: 'Triac' },
  { head: 'Bulb' },
  { head: 'Fuse' },
];
const giRows: Row[] = DATA.gi.map((g) => ({
  id: g.id,
  name: g.name,
  cells: [wire(g.wire), phrase(g.pin), mono(g.driver), phrase(g.bulb), fuse(g.fuse, g.fuseKey)],
}));
---

<Base
  title={TABLE_LABEL.coil}
  short={KIND_PLURAL.coil}
  nav="coils"
  description="Solenoids, flashers and flipper coils with wire colours, drivers and a Fault tick each."
>
  <h1>Solenoids and flashers</h1>
  <p class="muted">
    Every solenoid, flasher and flipper coil with its wire colours, pins, driver, coil and fuse.
    Tick Fault to put a coil or flasher on the <a href={href('shopping')}>shopping list</a>.
  </p>
  <!-- The provenance folds under one line (audit P2 item 10, VP3-18): it opened the page with
       eight lines on a phone. -->
  <details class="source">
    <summary>Source and notes</summary>
    <p class="prov">
      Source: <a href={manualHref('ops', 108)}>Solenoid/Flasher Table {pageTitleText('ops', 108)}</a
      > and{' '}
      <a href={manualHref('ops', 2)}>{pageRefText('ops', 2)}</a>. The fuse column is derived from
      the fuse list on {pageTitleText('ops', 57)}, not printed per coil, except the magnets 16, 23
      and 24, whose 5A S.B. fuse is printed in a footnote on {pageTitleText('ops', 2)}. The table
      lists {FLASHERS.table} flasher bulbs; the parts list sums to {FLASHERS.parts}. The manual does
      not say which count is right, so{' '}
      <a href={verifyHref('flasher-count')}>Verify</a> asks you to count them in the machine.
    </p>
  </details>

  {
    groups.map((g) => (
      <section class="card grp">
        <h2>{GROUP_HEADING[g]}</h2>
        <ComponentTable kind="coil" columns={COIL_COLUMNS} rows={coilRows(g)} />
      </section>
    ))
  }

  <div class="pair">
    <section class="card">
      <h2 id="flippers">Flipper coils</h2>
      <ComponentTable kind="flipper" columns={FLIPPER_COLUMNS} rows={flipperRows} />
      <p class="prov">
        Upper flippers are fed by the Extra Flipper Supply Board (F901/F902). Source: <a
          href={manualHref('ops', 112)}>Flipper Circuits {pageTitleText('ops', 112)}</a
        >.
      </p>
    </section>
    <section class="card">
      <h2 id="gi">General illumination</h2>
      <ComponentTable idHead="String" columns={GI_COLUMNS} rows={giRows} />
    </section>
  </div>
</Base>

<script>
  import '~/lib/fault-check';
</script>

<style>
  .grp {
    margin-bottom: var(--gap);
  }
  /* Spec §8.9: the flipper and GI tables stack at every width. Side by side they scrolled at 1000
     and broke their part numbers at 1440 (VP-05). */
  .pair {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--gap);
  }
</style>
