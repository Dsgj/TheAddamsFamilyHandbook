---
import Phrase from '~/components/Phrase.astro';
import Base from '~/layouts/Base.astro';
import { DATA } from '~/lib/data/components';
import { pageRefText, pageTitleText } from '~/lib/pages';
import { handbookHref, manualHref } from '~/lib/url';

const boards = [...new Set(DATA.fuses.map((f) => f.board))];
---

<Base
  title="Fuses, LEDs and jumpers"
  short="Fuses"
  nav="fuses"
  description="Fuse ratings, LED meanings and jumper settings from the Operations Manual."
>
  <h1>Fuses, LEDs and jumpers</h1>

  <section class="card">
    <h2 id="fuses">Fuses</h2>
    <p class="muted small">
      Source: <a href={manualHref('ops', 57)}>Fuse List {pageTitleText('ops', 57)}</a>. Always
      replace with the same rating and type (S.B. = slow blow).
    </p>
    {
      boards.map((b) => (
        <div class="board">
          <h3>{b}</h3>
          <div class="scroll-x">
            <table class="t">
              <thead>
                <tr>
                  <>
                    <th>Fuse</th>
                    <th>Circuit</th>
                    <th>Rating</th>
                  </>
                </tr>
              </thead>
              <tbody>
                {DATA.fuses
                  .filter((f) => f.board === b)
                  .map((f) => (
                    <tr id={f.key}>
                      <td class="mono">{f.id}</td>
                      <td>{f.circuit}</td>
                      <td class="mono">{f.rating}</td>
                    </tr>
                  ))}
              </tbody>
            </table>
          </div>
        </div>
      ))
    }
  </section>

  <section class="card">
    <h2 id="leds">Diagnostic LEDs</h2>
    <p class="muted small">
      Source: <a href={manualHref('ops', 56)}>LED List {pageTitleText('ops', 56)}</a>. Blink codes
      for the CPU LED are on <a href={handbookHref('errors')}>the error code page</a>.
    </p>
    <div class="scroll-x">
      <table class="t">
        <thead><tr><th>LED</th><th>What</th><th>Normal</th></tr></thead>
        <tbody>
          {
            DATA.leds.map((l) => (
              <tr>
                <td class="mono phrase">
                  <Phrase text={l.id} />
                </td>
                <td>{l.what}</td>
                <td>{l.normal}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <section class="card">
    <h2 id="jumpers">Jumper charts</h2>
    <p class="muted small">
      Transcribed on <a href={handbookHref('quick')}>the quick-reference page</a>; the manual page
      is <a href={manualHref('ops', 2)}>{pageRefText('ops', 2)}</a>.
    </p>
  </section>
</Base>

<style>
  .card {
    margin-bottom: var(--gap);
  }
  .board {
    margin-top: 12px;
  }
  .board h3 {
    font: var(--t-sub);
    font-weight: 600;
    color: var(--muted);
  }
</style>
