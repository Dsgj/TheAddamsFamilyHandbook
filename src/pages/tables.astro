---
import Base from '~/layouts/Base.astro';
import { DATA } from '~/lib/data/components';
import { href } from '~/lib/url';

/**
 * The Tables hub (spec §9.5): the matrices, the drivers and the board tables, with their counts
 * taken from src/data. "Recently viewed" stays hidden until Phase 7 fills it.
 */
const sw = DATA.switches;
const matrix = sw.filter((s) => s.col !== null).length;
const dedicated = sw.filter((s) => s.kind === 'ded').length;
const flipper = sw.filter((s) => s.kind === 'flip').length;

interface Row {
  href: string;
  title: string;
  sub?: string;
  value?: string;
  icon: string;
}
interface Group {
  head: string;
  rows: Row[];
}
const ICON = {
  grid: 'M4 4h5v5H4zM11 4h5v5h-5zM4 11h5v5H4zM11 11h5v5h-5z',
  lamp: 'M10 3a5 5 0 0 1 3 9v2H7v-2a5 5 0 0 1 3-9zM8 16h4',
  coil: 'M5 6h10M5 10h10M5 14h10M7 3v14M13 3v14',
  flip: 'M3 14l8-8M11 6h4v4',
  gi: 'M10 2v3M10 15v3M2 10h3M15 10h3M10 6a4 4 0 1 0 0 8a4 4 0 1 0 0-8z',
  fuse: 'M3 10h4l1-4 2 8 1-4h6',
  led: 'M10 3a4 4 0 0 1 4 4v5H6V7a4 4 0 0 1 4-4zM7 15h6M8 17h4',
  jumper: 'M4 6h12M4 14h12M7 6v8M13 6v8',
};
const GROUPS: Group[] = [
  {
    head: 'Matrices',
    rows: [
      {
        href: href('switches'),
        title: 'Switch matrix',
        sub: `${matrix} matrix, ${dedicated} dedicated, ${flipper} flipper`,
        icon: ICON.grid,
      },
      {
        href: href('lamps'),
        title: 'Lamp matrix',
        sub: `${DATA.lamps.length} lamps`,
        icon: ICON.lamp,
      },
    ],
  },
  {
    head: 'Drivers',
    rows: [
      {
        href: href('coils'),
        title: 'Solenoids & flashers',
        value: String(DATA.coils.length),
        icon: ICON.coil,
      },
      {
        href: href('coils#flippers'),
        title: 'Flipper coils',
        value: String(DATA.flippers.length),
        icon: ICON.flip,
      },
      {
        href: href('coils#gi'),
        title: 'General illumination',
        value: `${DATA.gi.length} strings`,
        icon: ICON.gi,
      },
    ],
  },
  {
    head: 'Boards',
    rows: [
      { href: href('fuses'), title: 'Fuses', value: String(DATA.fuses.length), icon: ICON.fuse },
      {
        href: href('fuses#leds'),
        title: 'Diagnostic LEDs',
        value: String(DATA.leds.length),
        icon: ICON.led,
      },
      { href: href('fuses#jumpers'), title: 'Jumper charts', icon: ICON.jumper },
    ],
  },
];
---

<Base
  title="Tables"
  nav="tables"
  description="The switch and lamp matrices, the solenoid table, fuses, LEDs and jumper charts."
>
  <div class="hub" data-hub="tables">
    <h1>Tables</h1>
    <input
      class="search"
      type="search"
      aria-label="Search tables"
      placeholder="Search tables"
      autocomplete="off"
    />
    <section hidden data-recent>
      <h2 class="lst-h">Recently viewed</h2>
      <ul class="lst"></ul>
    </section>
    {
      GROUPS.map((g) => (
        <section data-group>
          <h2 class="lst-h">{g.head}</h2>
          <ul class="lst">
            {g.rows.map((r) => (
              <li>
                <a class:list={['lrow', { two: !!r.sub }]} href={r.href}>
                  <span class="tile" aria-hidden="true">
                    <svg viewBox="0 0 20 20">
                      <path d={r.icon} />
                    </svg>
                  </span>
                  <span class="txt">
                    <span class="ttl">{r.title}</span>
                    {r.sub && <span class="sub">{r.sub}</span>}
                  </span>
                  {r.value && <span class="val">{r.value}</span>}
                  <svg class="chev" viewBox="0 0 14 14" aria-hidden="true">
                    <path d="M5 2l5 5-5 5" />
                  </svg>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
    <p class="gf" data-empty hidden>No table matches.</p>
  </div>
</Base>

<script>
  // "Search tables" filters the rows by their text as you type; a group with no match hides.
  const hub = document.querySelector<HTMLElement>('[data-hub="tables"]');
  const field = hub?.querySelector<HTMLInputElement>('input.search');
  if (hub && field) {
    const groups = [...hub.querySelectorAll<HTMLElement>('[data-group]')];
    const empty = hub.querySelector<HTMLElement>('[data-empty]');
    const apply = () => {
      const q = field.value.trim().toLowerCase();
      let shown = 0;
      for (const g of groups) {
        let n = 0;
        for (const li of g.querySelectorAll('li')) {
          const hit = !q || (li.textContent ?? '').toLowerCase().includes(q);
          li.hidden = !hit;
          if (hit) n++;
        }
        g.hidden = n === 0;
        shown += n;
      }
      if (empty) empty.hidden = shown > 0;
    };
    field.addEventListener('input', apply);
  }
</script>
