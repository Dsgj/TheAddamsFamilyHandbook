---
import Base from '~/layouts/Base.astro';
import { DATA } from '~/lib/data/components';
import { TABLE_LABEL } from '~/lib/copy';
import { href, tableHref } from '~/lib/url';

/**
 * The Tables hub (spec §9.5): the matrices, the drivers and the board tables, with their counts
 * taken from src/data. "Recently viewed" lists the components opened on this device.
 */
const sw = DATA.switches;
const matrix = sw.filter((s) => s.col !== null).length;
const dedicated = sw.filter((s) => s.kind === 'ded').length;
const flipper = sw.filter((s) => s.kind === 'flip').length;

interface Row {
  href: string;
  title: string;
  sub?: string;
  value?: string;
  icon: string;
}
interface Group {
  head: string;
  rows: Row[];
}
const ICON = {
  grid: 'M4 4h5v5H4zM11 4h5v5h-5zM4 11h5v5H4zM11 11h5v5h-5z',
  lamp: 'M10 3a5 5 0 0 1 3 9v2H7v-2a5 5 0 0 1 3-9zM8 16h4',
  coil: 'M5 6h10M5 10h10M5 14h10M7 3v14M13 3v14',
  flip: 'M3 14l8-8M11 6h4v4',
  gi: 'M10 2v3M10 15v3M2 10h3M15 10h3M10 6a4 4 0 1 0 0 8a4 4 0 1 0 0-8z',
  fuse: 'M3 10h4l1-4 2 8 1-4h6',
  led: 'M10 3a4 4 0 0 1 4 4v5H6V7a4 4 0 0 1 4-4zM7 15h6M8 17h4',
  jumper: 'M4 6h12M4 14h12M7 6v8M13 6v8',
};
const GROUPS: Group[] = [
  {
    head: 'Matrices',
    rows: [
      {
        href: tableHref('switch'),
        title: TABLE_LABEL.switch,
        sub: `${matrix} matrix, ${dedicated} dedicated, ${flipper} flipper`,
        icon: ICON.grid,
      },
      {
        href: tableHref('lamp'),
        title: TABLE_LABEL.lamp,
        sub: `${DATA.lamps.length} lamps`,
        icon: ICON.lamp,
      },
    ],
  },
  {
    head: 'Drivers',
    rows: [
      {
        href: tableHref('coil'),
        title: TABLE_LABEL.coil,
        value: String(DATA.coils.length),
        icon: ICON.coil,
      },
      {
        href: tableHref('coil', 'flippers'),
        title: 'Flipper coils',
        value: String(DATA.flippers.length),
        icon: ICON.flip,
      },
      {
        href: tableHref('coil', 'gi'),
        title: 'General illumination',
        value: `${DATA.gi.length} strings`,
        icon: ICON.gi,
      },
    ],
  },
  {
    head: 'Boards',
    rows: [
      { href: href('fuses'), title: 'Fuses', value: String(DATA.fuses.length), icon: ICON.fuse },
      {
        href: href('fuses#leds'),
        title: 'Diagnostic LEDs',
        value: String(DATA.leds.length),
        icon: ICON.led,
      },
      { href: href('fuses#jumpers'), title: 'Jumper charts', icon: ICON.jumper },
    ],
  },
];
---

<Base
  title="Tables"
  nav="tables"
  h1="large"
  description="The switch matrix, lamp matrix, solenoids and flashers, fuses and jumper charts, searchable."
>
  <div class="hub" data-hub="tables">
    <!-- The markup of SearchField.svelte (spec §8.7), written out: this page has no island. -->
    <div class="srch">
      <input
        class="search"
        type="search"
        aria-label="Search tables"
        placeholder="Search tables"
        autocomplete="off"
      />
      <button class="ibtn clear" type="button" aria-label="Clear search" hidden>
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8"></path></svg>
      </button>
    </div>
    <section hidden data-recent data-group>
      <h2 class="lst-h">Recently viewed</h2>
      <ul class="lst"></ul>
    </section>
    {
      GROUPS.map((g) => (
        <section data-group>
          <h2 class="lst-h">{g.head}</h2>
          <ul class="lst">
            {g.rows.map((r) => (
              <li>
                <a class:list={['lrow', { two: !!r.sub }]} href={r.href}>
                  <span class="tile" aria-hidden="true">
                    <svg viewBox="0 0 20 20">
                      <path d={r.icon} />
                    </svg>
                  </span>
                  <span class="txt">
                    <span class="ttl">{r.title}</span>
                    {r.sub && <span class="sub">{r.sub}</span>}
                  </span>
                  {r.value && <span class="val">{r.value}</span>}
                  <svg class="chev" viewBox="0 0 14 14" aria-hidden="true">
                    <path d="M5 2l5 5-5 5" />
                  </svg>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
    <p class="gf" data-empty hidden>No tables match.</p>
    <!-- Spec §12, audit AY-09: the filter's announcer, separate from the visible line above. -->
    <p class="sr-only" data-live aria-live="polite" aria-atomic="true"></p>
  </div>
</Base>

<style>
  /* .ibtn sets display: grid, which would beat the hidden attribute's UA rule. */
  .srch .clear[hidden] {
    display: none;
  }
</style>

<script>
  import { plural } from '~/lib/copy';
  import { viewedEntries } from '~/lib/model/recent.svelte';
  import { componentHref } from '~/lib/url';

  // "Recently viewed" (spec §9.5): the components opened on this device, newest first.
  const recent = document.querySelector<HTMLElement>('[data-recent]');
  const viewed = viewedEntries();
  if (recent && viewed.length) {
    const ul = recent.querySelector('ul');
    for (const v of viewed) {
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.className = 'lrow two';
      a.href = componentHref(v.kind, v.id);
      const code = document.createElement('span');
      code.className = 'code dmd';
      code.textContent = v.code;
      const txt = document.createElement('span');
      txt.className = 'txt';
      const ttl = document.createElement('span');
      ttl.className = 'ttl';
      ttl.textContent = v.name;
      const sub = document.createElement('span');
      sub.className = 'sub';
      sub.textContent = v.sub;
      txt.append(ttl, sub);
      const chev = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
      chev.setAttribute('class', 'chev');
      chev.setAttribute('viewBox', '0 0 14 14');
      chev.setAttribute('aria-hidden', 'true');
      const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      path.setAttribute('d', 'M5 2l5 5-5 5');
      chev.append(path);
      a.append(code, txt, chev);
      li.append(a);
      ul?.append(li);
    }
    recent.hidden = false;
  }

  // "Search tables" filters the rows by their text as you type; a group with no match hides.
  // "Clear search" shows while the field holds text; it empties the field, re-runs the filter
  // through an input event and puts focus back in the field (SearchField.svelte's behaviour).
  const hub = document.querySelector<HTMLElement>('[data-hub="tables"]');
  const field = hub?.querySelector<HTMLInputElement>('input.search');
  const clear = hub?.querySelector<HTMLButtonElement>('.srch .clear');
  if (hub && field) {
    const groups = [...hub.querySelectorAll<HTMLElement>('[data-group]')];
    const empty = hub.querySelector<HTMLElement>('[data-empty]');
    const live = hub.querySelector<HTMLElement>('[data-live]');
    let timer: ReturnType<typeof setTimeout> | undefined;
    const apply = () => {
      if (clear) clear.hidden = !field.value;
      const q = field.value.trim().toLowerCase();
      let shown = 0;
      for (const g of groups) {
        let n = 0;
        for (const li of g.querySelectorAll('li')) {
          const hit = !q || (li.textContent ?? '').toLowerCase().includes(q);
          li.hidden = !hit;
          if (hit) n++;
        }
        g.hidden = n === 0;
        shown += n;
      }
      if (empty) {
        empty.hidden = shown > 0;
        empty.textContent = `No tables match “${field.value.trim()}”.`;
      }
      // The count, announced 400 ms after the last keystroke; an empty field clears it at once.
      clearTimeout(timer);
      if (live && !q) live.textContent = '';
      else if (live) {
        const text = shown ? plural(shown, 'table') : `No tables match “${field.value.trim()}”.`;
        timer = setTimeout(() => (live.textContent = text), 400);
      }
    };
    field.addEventListener('input', apply);
    clear?.addEventListener('click', () => {
      field.value = '';
      field.dispatchEvent(new Event('input', { bubbles: true }));
      field.focus();
    });
  }
</script>
