---
import Icon from '~/components/Icon.astro';
import Base from '~/layouts/Base.astro';
import DocSeg from '~/components/DocSeg.astro';
import ManualSearch from '~/components/ManualSearch.svelte';
import { plural } from '~/lib/copy';
import { DOCS, DOC_NAME, pageCellText, pageCount, TOC } from '~/lib/pages';
import { manualHref } from '~/lib/url';

/** The Manuals index: the segmented links, the page-text search and each document's contents. */
---

<Base
  title="Manuals"
  nav="manual"
  h1="large"
  description="The Operations Manual, Operator's Handbook and WPC Schematic Manual, page by page, with their text searchable offline."
>
  <DocSeg current="manual" />
  <p class="muted">
    The manual pages of the three documents that came with the machine, with their text for
    searching.
  </p>
  <ManualSearch client:load />
  <div class="docs flush">
    {
      DOCS.map((d) => (
        <section>
          <h2 class="lst-h">
            <a href={manualHref(d, 1)}>{DOC_NAME[d]}</a>
            <span class="n">{plural(pageCount(d), 'page')}</span>
          </h2>
          <ul class="lst">
            {TOC[d].map(([p, name]) => (
              <li>
                <a class="lrow" href={manualHref(d, p)}>
                  <span class="txt">
                    <span class="ttl">{name}</span>
                  </span>
                  <span class="val mono">{pageCellText(d, p)}</span>
                  <Icon name="forward" class="chev" />
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
  <p class="gf">Manual pages are saved on the device as you open them.</p>
</Base>

<style>
  .docs {
    display: grid;
    gap: 0 var(--gap);
    margin-top: 4px;
  }
  @media (min-width: 1000px) {
    .docs {
      grid-template-columns: 1fr 1fr 1fr;
      align-items: start;
    }
  }
  /* Spec §12: the document link is a 44 target. Its box rises into the heading's top margin, so
     the text keeps its place just over the list and the box never reaches the first row. */
  .lst-h {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 8px;
    margin-top: 0;
  }
  .lst-h a {
    display: inline-flex;
    align-items: flex-end;
    min-height: var(--touch);
    color: inherit;
  }
  .lst-h .n {
    text-transform: none;
    letter-spacing: var(--track-0);
    font-weight: 500;
  }
  .lrow {
    min-height: var(--touch);
  }
</style>
