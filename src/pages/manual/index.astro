---
import Base from '~/layouts/Base.astro';
import DocSeg from '~/components/DocSeg.astro';
import ManualSearch from '~/components/ManualSearch.svelte';
import { DOCS, DOC_NAME, DOC_UNIT, pageCount, pageLabel, TOC } from '~/lib/pages';
import { manualHref } from '~/lib/url';

/** The Manuals index: the segmented links, the OCR search and each document's contents. */
---

<Base title="Manuals" nav="manual">
  <h1>Manuals</h1>
  <DocSeg current="manual" />
  <p class="muted">
    Page scans of the three documents that came with the machine, with OCR text for searching.
  </p>
  <ManualSearch client:load />
  <div class="docs">
    {
      DOCS.map((d) => (
        <section>
          <h2 class="lst-h">
            <a href={manualHref(d, 1)}>{DOC_NAME[d]}</a>
            <span class="n">
              {pageCount(d)} {DOC_UNIT[d]}
            </span>
          </h2>
          <ul class="lst">
            {TOC[d].map(([p, name]) => (
              <li>
                <a class="lrow" href={manualHref(d, p)}>
                  <span class="txt">
                    <span class="ttl">{name}</span>
                  </span>
                  <span class="val mono">{pageLabel(d, p) || `#${p}`}</span>
                  <svg class="chev" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
  <p class="gf">Scans are saved on the device as you open them.</p>
</Base>

<style>
  .docs {
    display: grid;
    gap: 0 var(--gap);
    margin-top: 4px;
  }
  @media (min-width: 900px) {
    .docs {
      grid-template-columns: 1fr 1fr 1fr;
      align-items: start;
    }
  }
  .lst,
  .lst-h,
  .gf {
    margin-left: 0;
    margin-right: 0;
  }
  .lst-h {
    display: flex;
    justify-content: space-between;
    gap: 8px;
  }
  .lst-h a {
    color: inherit;
  }
  .lst-h .n {
    text-transform: none;
    letter-spacing: 0;
    font-weight: 500;
  }
  .lrow {
    min-height: 44px;
  }
</style>
