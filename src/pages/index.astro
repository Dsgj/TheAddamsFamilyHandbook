---
import Icon from '~/components/Icon.astro';
import Base from '~/layouts/Base.astro';
import Diagnose from '~/components/Diagnose.svelte';

/**
 * The Diagnose home (spec §9.1). The old quick links live in their hubs: Test menu and Error
 * messages on /handbook, Fuses on /tables, Verify, Setup and Care on /workshop, the map layers on
 * the Map tab. The bar's "Recent" button talks to the island through the `diag` app event.
 */
---

<Base
  title="Diagnose"
  nav="diagnose"
  h1="large"
  description="Type a switch, lamp, solenoid or error code and get the component, its manual page and what to check."
>
  <Fragment slot="actions">
    <button class="ibtn" type="button" aria-label="Recent" data-diag="recent">
      <Icon name="clock" />
    </button>
  </Fragment>
  <Diagnose client:load />
</Base>

<script>
  import { emit } from '~/lib/events';

  for (const b of document.querySelectorAll<HTMLButtonElement>('button[data-diag]'))
    b.addEventListener('click', () => emit('diag', b.dataset.diag ?? ''));
</script>
