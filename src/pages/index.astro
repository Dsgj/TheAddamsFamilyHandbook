---
import Base from '~/layouts/Base.astro';
import Diagnose from '~/components/Diagnose.svelte';

/**
 * The Diagnose home (spec §9.1). The old quick links live in their hubs: Test menu and Error
 * messages on /handbook, Fuses on /tables, Verify, Setup and Care on /workshop, the map layers on
 * the Map tab. The bar's "Recent reports" button talks to the island through a `tafh:diag` event.
 */
---

<Base
  title="Diagnose"
  nav="diagnose"
  h1="large"
  description="Type a switch, lamp, solenoid or error code and get the component, its manual page and what to check."
>
  <Fragment slot="actions">
    <button class="ibtn" type="button" aria-label="Recent reports" data-diag="recent">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="8.5"></circle><path d="M12 7.5V12l3 2"></path>
      </svg>
    </button>
  </Fragment>
  <Diagnose client:load />
</Base>

<script>
  document
    .querySelectorAll<HTMLButtonElement>('button[data-diag]')
    .forEach((b) =>
      b.addEventListener('click', () =>
        document.dispatchEvent(new CustomEvent('tafh:diag', { detail: b.dataset.diag })),
      ),
    );
</script>
