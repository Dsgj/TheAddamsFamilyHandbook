---
import Base from '~/layouts/Base.astro';
// Keep the lib imports above Matrix: Astro orders the head CSS by import position, and this order
// keeps the .tabs style after Matrix.css (the dist diff of audit P4 item 1 proves the output).
import { KIND_PLURAL, TABLE_LABEL } from '~/lib/copy';
import { pageTitleText } from '~/lib/pages';
import { matrixCells } from '~/lib/matrix';
import type { Switch } from '~/lib/model/types';
import { mono, wire } from '~/lib/table';
import type { Column, Row } from '~/lib/table';
import Matrix from '~/components/Matrix.svelte';
import ComponentTable from '~/components/ComponentTable.astro';
import { DATA } from '~/lib/data/components';
import { manualHref } from '~/lib/url';

/**
 * The switch matrix (spec §9.6): a tablist "Switch matrix view" with Matrix / Dedicated /
 * Flippers; each panel heading carries the connectors. All three panels render at build time; the inactive ones carry `hidden`, so the
 * "Fault" ticks in every panel load their stored state on import.
 */
const matrix = matrixCells(DATA.switches);
const ded = DATA.switches.filter((s) => s.circuit === 'ded');
const flip = DATA.switches.filter((s) => s.circuit === 'flip');
/** The dedicated and flipper switch tables: the wire and the pin beside the name. */
const SW_COLUMNS: Column[] = [{ head: 'Wire' }, { head: 'Pin' }];
const swRows = (list: Switch[]): Row[] =>
  list.map((s) => ({ id: s.id, name: s.name, cells: [wire(s.wire), mono(s.pin)] }));

const TABS = [
  { id: 'matrix', label: 'Matrix' },
  { id: 'j205', label: 'Dedicated' },
  { id: 'j806', label: 'Flippers' },
];
---

<Base
  title={TABLE_LABEL.switch}
  short={KIND_PLURAL.switch}
  nav="switches"
  description="The switch matrix and the dedicated and flipper switches, with a Fault tick per switch."
>
  <h1>Switch matrix</h1>
  <div class="seg tabs" role="tablist" aria-label="Switch matrix view">
    {
      TABS.map((t, i) => (
        <button
          type="button"
          role="tab"
          id={`tab-${t.id}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          aria-controls={`panel-${t.id}`}
          tabindex={i === 0 ? 0 : -1}
        >
          {t.label}
        </button>
      ))
    }
  </div>

  <div id="panel-matrix" role="tabpanel" aria-labelledby="tab-matrix" class="panel">
    <p class="muted">
      Columns are driven from CPU J206/J207 through U20, rows read on J208/J209 through U18. Source:{
        ' '
      }
      <a href={manualHref('ops', 106)}>Switch Matrix {pageTitleText('ops', 106)}</a>.{' '}
      <span class="kbd-only">Use the arrow keys to move between cells.</span>
    </p>
    <Matrix client:load kind="switch" cells={matrix} cols={DATA.swCols} rows={DATA.swRows} />
  </div>

  <div id="panel-j205" role="tabpanel" aria-labelledby="tab-j205" class="panel" hidden>
    <section class="card">
      <h2>Dedicated switches (J205)</h2>
      <ComponentTable kind="switch" columns={SW_COLUMNS} rows={swRows(ded)} />
    </section>
  </div>

  <div id="panel-j806" role="tabpanel" aria-labelledby="tab-j806" class="panel" hidden>
    <section class="card">
      <h2>Flipper switches (Fliptronics J805/J806)</h2>
      <ComponentTable kind="switch" columns={SW_COLUMNS} rows={swRows(flip)} />
      <p class="prov">
        EOS switch part numbers differ between the flipper page and the parts list (SW-1A-193 vs
        SW-1A-194). Both are recorded on each switch.
      </p>
    </section>
  </div>
</Base>

<script>
  import '~/lib/fault-check';
  import { isTypingTarget } from '~/lib/keys';

  // The tablist (spec §8.3, tabs variant): a click or the arrow keys move aria-selected and show
  // the matching panel; Home and End jump to the ends. `#j205` / `#j806` open that tab directly.
  const list = document.querySelector<HTMLElement>('[role="tablist"]');
  const tabs = list ? [...list.querySelectorAll<HTMLButtonElement>('[role="tab"]')] : [];
  const select = (i: number, focus = false) => {
    tabs.forEach((t, j) => {
      const on = i === j;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      const panel = document.getElementById(t.getAttribute('aria-controls') ?? '');
      if (panel) panel.hidden = !on;
    });
    if (focus) tabs[i]?.focus();
  };
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => select(i));
    t.addEventListener('keydown', (e) => {
      // One guard (spec §12, audit AY-11): Alt+arrow stays the browser's Back, never a tab move.
      if (isTypingTarget(e.target) || e.altKey || e.ctrlKey || e.metaKey) return;
      const n = tabs.length;
      let to = -1;
      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') to = (i + 1) % n;
      else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') to = (i - 1 + n) % n;
      else if (e.key === 'Home') to = 0;
      else if (e.key === 'End') to = n - 1;
      if (to < 0) return;
      e.preventDefault();
      select(to, true);
    });
  });
  const wanted = tabs.findIndex(
    (t) => t.getAttribute('aria-controls') === `panel-${location.hash.slice(1)}`,
  );
  if (wanted > 0) select(wanted);
</script>

<style>
  .tabs {
    display: grid;
    max-width: 480px;
    margin: 0 0 var(--gap);
  }
  .panel > .card {
    margin: 0;
  }
</style>
