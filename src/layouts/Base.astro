---
import '~/styles/tokens.css';
import '~/styles/base.css';
import { pwaInfo } from 'virtual:pwa-info';
import { href } from '~/lib/url';
import { TABS, tabFor } from '~/lib/nav';
import { allShoppingItems } from '~/lib/shopping';
import QuickSearch from '~/components/QuickSearch.svelte';
import TabBadge from '~/components/TabBadge.svelte';

interface Props {
  title: string;
  description?: string;
  /** Active nav key. */
  nav?: string;
  wide?: boolean;
  /** Full-bleed page (the map): no gutter or max-width on main, and no footer. */
  fullbleed?: boolean;
}
const {
  title,
  description = 'Offline service companion for The Addams Family pinball.',
  nav,
  wide,
  fullbleed,
} = Astro.props;

const tab = tabFor(nav);
/** The Shopping list's candidate keys, so the badge counts exactly what the list shows. */
const shopKeys = allShoppingItems().map((i) => `${i.kind}:${i.id}`);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title} · The Addams Family Handbook</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0E0B10" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#EFE9DA" media="(prefers-color-scheme: light)" />
    <link rel="icon" href={href('icons/icon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={href('icons/icon-192.png')} />
    {pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} />}
    <script is:inline>
      try {
        const t = localStorage.getItem('tafh:theme') ?? localStorage.getItem('valvet:theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
    <script src="~/pwa.ts"></script>
  </head>
  <body>
    <a class="sr-only" href="#main">Skip to content</a>
    <nav class="shell" aria-label="Sections">
      <a class="shell-logo" href={href('')} aria-label="The Addams Family Handbook home">
        <img
          src={href('brand/logo.webp')}
          alt="The Addams Family"
          width="160"
          height="81"
          decoding="async"
        />
      </a>
      <ul class="tabs">
        {
          TABS.map((t) => (
            <li>
              <a
                class="tab"
                href={href(t.path)}
                data-tab={t.key}
                aria-current={tab === t.key ? 'page' : undefined}
              >
                <svg class="ico" viewBox="0 0 24 24" aria-hidden="true">
                  <path d={t.icon} />
                </svg>
                <span class="lbl">{t.label}</span>
                {t.key === 'workshop' && <TabBadge client:load keys={shopKeys} />}
              </a>
              {t.subs.length > 0 && (
                <ul class="subs">
                  {t.subs.map((s) => (
                    <li>
                      <a
                        class="sub"
                        href={href(s.path)}
                        aria-current={s.nav && nav === s.nav ? 'page' : undefined}
                      >
                        <span class="lbl">{s.label}</span>
                        {s.count && <TabBadge client:load keys={shopKeys} pill />}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
    </nav>
    <header class="top">
      <div class="top-row">
        <a class="brand" href={href('')} aria-label="The Addams Family Handbook home">
          <img
            class="brand-logo"
            src={href('brand/logo.webp')}
            alt="The Addams Family"
            width="800"
            height="406"
            decoding="async"
          />
          <span class="brand-sub">Handbook</span>
        </a>
        <QuickSearch client:idle />
      </div>
    </header>
    <main id="main" class:list={[{ wrap: !fullbleed, wide, fullbleed }]}>
      <slot />
    </main>
    {
      !fullbleed && (
        <footer class="foot wrap muted small">
          <p>
            The Addams Family Handbook is a private service tool for one machine. Manual text and
            scans are © Williams Electronics Games / Midway; hints marked as such are the owner's
            own experience.
          </p>
        </footer>
      )
    }
    <p id="sw-status" hidden></p>
    <script is:inline>
      (function () {
        // Interim (until the Phase 5 top bar): publish the sticky header's height as --topbar-h so
        // the map's fit rule and scroll padding follow the real header.
        const top = document.querySelector('header.top');
        if (top && 'ResizeObserver' in window) {
          const publish = function () {
            document.documentElement.style.setProperty('--topbar-h', top.offsetHeight + 'px');
          };
          publish();
          new ResizeObserver(publish).observe(top);
        }
        // Reselecting the current tab (spec §6.1): on the tab's root it scrolls to the top and
        // focuses the h1; on a pushed page the link itself goes to the root.
        const norm = function (p) {
          return p.replace(/\.html$/, '').replace(/\/index$/, '').replace(/\/$/, '');
        };
        const shell = document.querySelector('nav.shell');
        if (shell) {
          shell.addEventListener('click', function (e) {
            const a = e.target.closest && e.target.closest('a.tab[aria-current="page"]');
            if (!a || norm(location.pathname) !== norm(new URL(a.href).pathname)) return;
            e.preventDefault();
            window.scrollTo({ top: 0 });
            const h1 = document.querySelector('h1');
            if (h1) {
              h1.tabIndex = -1;
              h1.focus({ preventScroll: true });
            }
          });
        }
      })();
    </script>
  </body>
</html>

<style>
  .top {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--ground) 92%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .top-row {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 6px var(--pad);
    max-width: 1120px;
    margin: 0 auto;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
  }
  .brand:hover {
    text-decoration: none;
  }
  .brand-logo {
    height: 40px;
    width: auto;
    filter: drop-shadow(0 0 8px var(--amber-glow));
  }
  .brand-sub {
    color: var(--muted);
    font-size: 0.8rem;
    display: none;
  }
  @media (min-width: 700px) {
    .brand-logo {
      height: 44px;
    }
    .brand-sub {
      display: inline;
    }
  }
  /* From 1280 the sidebar carries the logo; the header keeps only the search until Phase 5. */
  @media (min-width: 1280px) {
    .brand {
      display: none;
    }
    .top-row {
      justify-content: flex-end;
    }
  }
  main.wide {
    max-width: 1400px;
  }
  .foot {
    border-top: 1px solid var(--line);
    margin-top: 32px;
  }
</style>
