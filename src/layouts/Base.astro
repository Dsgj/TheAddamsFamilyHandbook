---
import Icon from '~/components/Icon.astro';
import '~/styles/tokens.css';
// The global sheet in cascade order (audit AR2-08): on a tie, the later part wins.
import '~/styles/base.css';
import '~/styles/layout.css';
import '~/styles/surfaces.css';
import '~/styles/buttons.css';
import '~/styles/content.css';
import '~/styles/lists.css';
import '~/styles/controls.css';
import '~/styles/nav.css';
import '~/styles/motion.css';
import '~/styles/print.css';
import { pwaInfo } from 'virtual:pwa-info';
import { href } from '~/lib/url';
import { jsonScript } from '~/lib/json-script';
import { inlineScript } from '~/lib/inline-script';
import classifySrc from '~/inline/classify.js?raw';
import revealSrc from '~/inline/reveal.js?raw';
import themeSrc from '~/inline/theme.js?raw';
import Toast from '~/components/Toast.svelte';
import { PARENT, TABS, tabFor, type BackLink } from '~/lib/nav';
import { depthOf } from '~/lib/nav-state';
import { LEGACY_KEYS, PREF_KEYS, SESSION_KEYS } from '~/lib/storage';
import { allShoppingItems } from '~/lib/data/shopping';
import TabBadge from '~/components/TabBadge.svelte';
import { DESKTOP } from '~/lib/bp';

interface Props {
  /** The document title. Also the top bar's text unless `heading` says otherwise. */
  title: string;
  /** The top bar's text when it differs from the document title (e.g. "Switch 32"). */
  heading?: string;
  /** A shorter word phones show in place of `heading` (the accessible text stays `heading`). */
  short?: string | undefined;
  description?: string;
  /** Active nav key. */
  nav?: string;
  /**
   * Which element is the page's one h1 (spec §6.5). 'large': a tab root or one of the Handbook
   * tab's sibling index pages; the large title under the bar is the h1. 'page': the page renders
   * its own h1; the bar's title is decoration and shows once that h1 has scrolled under the bar.
   * 'bar': the compact title is the h1.
   */
  h1?: 'large' | 'page' | 'bar';
  /**
   * The back link. Defaults to the nav key's static parent on pushed pages; `null` for none.
   * `'context'` (the Map, a tab root): none static, but motion.ts adds one to the page this one
   * was opened from, when that was elsewhere on the site (audit UX3-07).
   */
  back?: BackLink | 'context' | null;
  /** Full-bleed page (the map): no gutter or max-width on main, and no footer. */
  fullbleed?: boolean;
}
const {
  title,
  heading = title,
  short,
  description = 'Offline service companion for The Addams Family pinball.',
  nav,
  h1 = 'page',
  back = h1 === 'large' ? null : nav ? PARENT[nav] : null,
  fullbleed,
} = Astro.props;
/** The static back link; 'context' renders none and leaves motion.ts a template for one. */
const parent: BackLink | null = back && back !== 'context' ? back : null;

const tab = tabFor(nav);
/**
 * 0 on a tab root, 1 under it, 2 under that: the pagereveal script reads push against pop from it.
 * A page whose parent is a tab root is 1 (a Handbook section, Manuals), anything deeper 2.
 */
const depth = depthOf(
  parent?.path,
  TABS.map((t) => t.path),
);
/** What a back link to this page says (motion.ts): the phone's short title, else the heading. */
const label = short ?? heading;
/**
 * The Shopping list's candidate ids by kind, so the badge counts exactly what the list shows:
 * one JSON script in the shell (#tafh-shop) that both TabBadge islands read on mount, instead of
 * the same 4 KB riding as props on each (audit P4 item 5, SV-10).
 */
const shopIds: Record<string, string[]> = {};
for (const i of allShoppingItems()) (shopIds[i.kind] ??= []).push(i.id);
const hasActions = Astro.slots.has('actions');
---

<!doctype html>
<html lang="en" data-tab={tab} data-depth={depth} data-label={label}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title} · The Addams Family Handbook</title>
    <meta name="description" content={description} />
    <!-- data-own keeps each colour: the head script and Appearance point both at the chosen theme. -->
    <meta
      name="theme-color"
      content="#0E0B10"
      media="(prefers-color-scheme: dark)"
      data-own="#0E0B10"
    />
    <meta
      name="theme-color"
      content="#EFE9DA"
      media="(prefers-color-scheme: light)"
      data-own="#EFE9DA"
    />
    <link rel="icon" href={href('icons/icon.svg')} type="image/svg+xml" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="TAF Handbook" />
    <link rel="apple-touch-icon" href={href('icons/icon-180.png')} />
    <link
      rel="apple-touch-startup-image"
      href={href('icons/startup-1170x2532.png')}
      media="(device-width: 390px) and (device-height: 844px) and (-webkit-device-pixel-ratio: 3) and (orientation: portrait)"
    />
    {pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} />}
    {
      /* Before the first paint, from src/inline through inlineScript: the chosen theme, then the
        view transition's type from classify.js. Their keys ride as data attributes. */
    }
    <script
      is:inline
      data-theme={PREF_KEYS.theme}
      data-old-theme={LEGACY_KEYS.theme}
      set:html={inlineScript(themeSrc)}
    />
    <script
      is:inline
      data-prev={SESSION_KEYS.prev}
      set:html={inlineScript(classifySrc, revealSrc)}
    />
    <link rel="expect" href="#main" blocking="render" />
    {
      /* The tab bar comes after the page now, so the first frame (and a view transition's new
        snapshot) waits for it too. */
    }
    <link rel="expect" href="#sections" blocking="render" />
    <script src="~/pwa.ts"></script>
    <script src="~/motion.ts"></script>
    <script src="~/shell.ts"></script>
  </head>
  <body>
    <a class="skip sr-only" href="#main">Skip to content</a>
    <script is:inline type="application/json" id="tafh-shop" set:html={jsonScript(shopIds)} />
    <header class="top" data-h1={h1}>
      <div class="tb">
        <div class="lead">
          {
            parent && (
              <a class="back" href={href(parent.path)}>
                <Icon name="back" />
                <span>{parent.label}</span>
              </a>
            )
          }
        </div>
        {
          h1 === 'bar' ? (
            <h1 class="ct">
              <span class:list={['full', { 'has-short': !!short }]}>{heading}</span>
              {short && (
                <span class="short" aria-hidden="true">
                  {short}
                </span>
              )}
            </h1>
          ) : (
            <div class="ct" aria-hidden="true">
              <span class:list={['full', { 'has-short': !!short }]}>{heading}</span>
              {short && <span class="short">{short}</span>}
            </div>
          )
        }
        <div class="trail">{hasActions && <slot name="actions" />}</div>
      </div>
    </header>
    {
      /* A tab root opened from elsewhere on the site (the Map from a card's Show on map) gets a
         back link there: motion.ts clones this into the lead when the record says so (UX3-07). */
      back === 'context' && (
        <template id="tafh-back">
          <a class="back" href={href('')} data-ctx>
            <Icon name="back" />
            <span />
          </a>
        </template>
      )
    }
    <main id="main" class:list={[{ wrap: !fullbleed, fullbleed }]}>
      {
        h1 === 'large' && (
          <div class="lt">
            <h1>{heading}</h1>
          </div>
        )
      }
      <slot />
    </main>
    {
      /* After the page, so a screen reader and the Tab key meet the header and the content
        first, in the order a phone shows them (AY2-04); the shell is fixed, so its place in the
        DOM moves nothing on screen. */
    }
    <nav id="sections" class="shell" aria-label="Sections">
      <a class="shell-logo" href={href('')} aria-label="The Addams Family Handbook home">
        <img
          src={href('brand/logo.webp')}
          alt="The Addams Family"
          width="160"
          height="81"
          decoding="async"
          loading="lazy"
        />
      </a>
      <ul class="tabs">
        {
          TABS.map((t) => (
            <li>
              <a
                class="tab"
                href={href(t.path)}
                data-tab={t.key}
                aria-current={tab === t.key ? 'page' : undefined}
              >
                <Icon name={t.icon} class="ico" />
                <span class="lbl">{t.label}</span>
                {/* At an idle moment, or after 200 ms, the wait Astro gives it anyway where there
                    is no requestIdleCallback (Safari): a CI Chromium once had none in 15 s. */}
                {t.key === 'workshop' && <TabBadge client:idle={{ timeout: 200 }} />}
              </a>
              {t.subs.length > 0 && (
                <ul class="subs">
                  {t.subs.map((s) => (
                    <li>
                      <a
                        class="sub"
                        href={href(s.path)}
                        aria-current={s.nav && nav === s.nav ? 'page' : undefined}
                      >
                        <span class="lbl">{s.label}</span>
                        {s.count && <TabBadge client:media={DESKTOP} pill />}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
    </nav>
    {
      !fullbleed && (
        <footer class="foot wrap muted small">
          <p>
            The Addams Family Handbook is a private service tool for one machine. Manual text and
            pages are © Williams Electronics Games / Midway; hints marked as such are the owner's
            own experience.
          </p>
        </footer>
      )
    }
    <Toast client:load />
  </body>
</html>
