---
import '~/styles/tokens.css';
import '~/styles/base.css';
import { pwaInfo } from 'virtual:pwa-info';
import { href } from '~/lib/url';
import Toast from '~/components/Toast.svelte';
import { PARENT, TABS, tabFor, type BackLink } from '~/lib/nav';
import { allShoppingItems } from '~/lib/shopping';
import TabBadge from '~/components/TabBadge.svelte';

interface Props {
  /** The document title. Also the top bar's text unless `heading` says otherwise. */
  title: string;
  /** The top bar's text when it differs from the document title (e.g. "Switch 32"). */
  heading?: string;
  /** A shorter word phones show in place of `heading` (the accessible text stays `heading`). */
  short?: string;
  description?: string;
  /** Active nav key. */
  nav?: string;
  /**
   * Which element is the page's one h1 (spec §6.5). 'large': a tab root; the large title under
   * the bar is the h1. 'page': the page renders its own h1; the bar's title is decoration.
   * 'bar': the compact title is the h1.
   */
  h1?: 'large' | 'page' | 'bar';
  /** The back link. Defaults to the nav key's static parent on pushed pages; `null` for none. */
  back?: BackLink | null;
  wide?: boolean;
  /** Full-bleed page (the map): no gutter or max-width on main, and no footer. */
  fullbleed?: boolean;
}
const {
  title,
  heading = title,
  short,
  description = 'Offline service companion for The Addams Family pinball.',
  nav,
  h1 = 'page',
  back = h1 === 'large' ? null : nav ? PARENT[nav] : null,
  wide,
  fullbleed,
} = Astro.props;

const tab = tabFor(nav);
/** The Shopping list's candidate keys, so the badge counts exactly what the list shows. */
const shopKeys = allShoppingItems().map((i) => `${i.kind}:${i.id}`);
const hasActions = Astro.slots.has('actions');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title} · The Addams Family Handbook</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0E0B10" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#EFE9DA" media="(prefers-color-scheme: light)" />
    <link rel="icon" href={href('icons/icon.svg')} type="image/svg+xml" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="TAF Handbook" />
    <link rel="apple-touch-icon" href={href('icons/icon-180.png')} />
    <link
      rel="apple-touch-startup-image"
      href={href('icons/startup-1170x2532.png')}
      media="(device-width: 390px) and (device-height: 844px) and (-webkit-device-pixel-ratio: 3) and (orientation: portrait)"
    />
    {pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} />}
    <script is:inline>
      try {
        const t = localStorage.getItem('tafh:theme') ?? localStorage.getItem('valvet:theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
    <script src="~/pwa.ts"></script>
  </head>
  <body>
    <a class="sr-only" href="#main">Skip to content</a>
    <nav class="shell" aria-label="Sections">
      <a class="shell-logo" href={href('')} aria-label="The Addams Family Handbook home">
        <img
          src={href('brand/logo.webp')}
          alt="The Addams Family"
          width="160"
          height="81"
          decoding="async"
        />
      </a>
      <ul class="tabs">
        {
          TABS.map((t) => (
            <li>
              <a
                class="tab"
                href={href(t.path)}
                data-tab={t.key}
                aria-current={tab === t.key ? 'page' : undefined}
              >
                <svg class="ico" viewBox="0 0 24 24" aria-hidden="true">
                  <path d={t.icon} />
                </svg>
                <span class="lbl">{t.label}</span>
                {t.key === 'workshop' && <TabBadge client:load keys={shopKeys} />}
              </a>
              {t.subs.length > 0 && (
                <ul class="subs">
                  {t.subs.map((s) => (
                    <li>
                      <a
                        class="sub"
                        href={href(s.path)}
                        aria-current={s.nav && nav === s.nav ? 'page' : undefined}
                      >
                        <span class="lbl">{s.label}</span>
                        {s.count && <TabBadge client:load keys={shopKeys} pill />}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
    </nav>
    <header class="top" data-h1={h1}>
      <div class="tb">
        <div class="lead">
          {
            back && (
              <a class="back" href={href(back.path)}>
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M15 5l-7 7 7 7" />
                </svg>
                <span>{back.label}</span>
              </a>
            )
          }
        </div>
        {
          h1 === 'bar' ? (
            <h1 class="ct">
              <span class:list={['full', { 'has-short': !!short }]}>{heading}</span>
              {short && (
                <span class="short" aria-hidden="true">
                  {short}
                </span>
              )}
            </h1>
          ) : (
            <div class="ct" aria-hidden="true">
              {heading}
            </div>
          )
        }
        <div class="trail">{hasActions && <slot name="actions" />}</div>
      </div>
    </header>
    <main id="main" class:list={[{ wrap: !fullbleed, wide, fullbleed }]}>
      {
        h1 === 'large' && (
          <div class="lt">
            <h1>{heading}</h1>
          </div>
        )
      }
      <slot />
    </main>
    {
      !fullbleed && (
        <footer class="foot wrap muted small">
          <p>
            The Addams Family Handbook is a private service tool for one machine. Manual text and
            scans are © Williams Electronics Games / Midway; hints marked as such are the owner's
            own experience.
          </p>
        </footer>
      )
    }
    <Toast client:load />
    <script is:inline>
      (function () {
        // The large title collapses over the first 52 px of scroll (spec §6.5): the compact
        // title fades in between 40 and 52 and the hairline appears at 52. Under reduced motion
        // the titles swap at 52.
        const top = document.querySelector('header.top');
        const lt = document.querySelector('main > .lt');
        if (top && lt) {
          const reduce = matchMedia('(prefers-reduced-motion: reduce)');
          let queued = false;
          const apply = function () {
            queued = false;
            const y = Math.max(0, window.scrollY);
            const done = y >= 52;
            const ct = reduce.matches ? (done ? 1 : 0) : Math.min(1, Math.max(0, (y - 40) / 12));
            const large = reduce.matches ? (done ? 0 : 1) : Math.max(0, 1 - y / 52);
            top.style.setProperty('--ct', String(ct));
            lt.style.setProperty('--lt', String(large));
            top.toggleAttribute('data-collapsed', done);
          };
          const onScroll = function () {
            if (queued) return;
            queued = true;
            requestAnimationFrame(apply);
          };
          apply();
          addEventListener('scroll', onScroll, { passive: true });
          reduce.addEventListener('change', apply);
        }
        // Reselecting the current tab (spec §6.1): on the tab's root it scrolls to the top and
        // focuses the h1; on a pushed page the link itself goes to the root.
        const norm = function (p) {
          return p
            .replace(/\.html$/, '')
            .replace(/\/index$/, '')
            .replace(/\/$/, '');
        };
        const shell = document.querySelector('nav.shell');
        if (shell) {
          shell.addEventListener('click', function (e) {
            const a = e.target.closest && e.target.closest('a.tab[aria-current="page"]');
            if (!a || norm(location.pathname) !== norm(new URL(a.href).pathname)) return;
            e.preventDefault();
            window.scrollTo({ top: 0 });
            const h1 = document.querySelector('h1');
            if (h1) {
              h1.tabIndex = -1;
              h1.focus({ preventScroll: true });
            }
          });
        }
      })();
    </script>
  </body>
</html>
