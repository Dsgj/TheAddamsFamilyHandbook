---
import Base from './Base.astro';
import ComponentDetail, { type Related } from '~/components/ComponentDetail.svelte';
import type { AnyComponent } from '~/lib/data/components';
import { DATA, KIND_LABEL, MAP_LAYER } from '~/lib/data/components';
import type { Kind } from '~/lib/model/types';
import { componentHref, href } from '~/lib/url';
import { appendixFor, APPENDICES, serviceNotes } from '~/data/appendix';
import { findHeading, type HeadingIndex } from '~/lib/handbook/render';
import { handbookToc } from '~/lib/handbook/toc';

/**
 * The component detail page (spec §9.7). The island draws the anatomy; this layout adds the
 * owner's service notes and appendix links (read by the tests) and the prev/next pager (Q18).
 */
interface Props {
  kind: Kind;
  item: AnyComponent;
  list: AnyComponent[];
}
const { kind, item, list } = Astro.props;
const i = list.findIndex((x) => x.id === item.id);
const prev = list[i - 1];
const next = list[i + 1];
const listPath = kind === 'switch' ? 'switches' : kind === 'lamp' ? 'lamps' : 'coils';
/** The back link's label: the list page's name. */
const listLabel = kind === 'switch' ? 'Switches' : kind === 'lamp' ? 'Lamps' : 'Solenoids';
const layer = MAP_LAYER[kind];

/** Related components: the same name (the lamp and coil of a jet bumper) or the same assembly. */
const codeOf = (k: Kind, id: string) => (k === 'coil' ? `SOL ${id}` : k === 'lamp' ? `L${id}` : id);
const subOf = (k: Kind, c: AnyComponent) => {
  if (k === 'lamp' && 'bulb' in c) return `Lamp · bulb ${c.bulb}`;
  if (k === 'coil' && 'type' in c) return `Solenoid · ${c.type}`;
  if (k === 'switch' && 'col' in c && c.col !== null)
    return `Switch · matrix column ${c.col}, row ${c.row}`;
  return KIND_LABEL[k];
};
const name = item.name.trim().toLowerCase();
const pool: [Kind, AnyComponent][] = [
  ...DATA.switches.map((c): [Kind, AnyComponent] => ['switch', c]),
  ...DATA.lamps.map((c): [Kind, AnyComponent] => ['lamp', c]),
  ...DATA.coils.map((c): [Kind, AnyComponent] => ['coil', c]),
];
const sameName = ([, c]: [Kind, AnyComponent]) => c.name.trim().toLowerCase() === name;
const related: Related[] = pool
  .filter(
    ([k, c]) =>
      !(k === kind && c.id === item.id) &&
      !('unused' in c && c.unused) &&
      (sameName([k, c]) || (!!item.assy && c.assy === item.assy)),
  )
  .sort((a, b) => Number(sameName(b)) - Number(sameName(a)))
  .slice(0, 8)
  .map(([k, c]) => ({
    href: componentHref(k, c.id),
    code: codeOf(k, c.id),
    name: c.name,
    sub: subOf(k, c),
  }));

/** Owner appendices that apply to this component, resolved to their Handbook headings. */
const toc = await handbookToc();
const idx: HeadingIndex = new Map(
  toc
    .filter((t) => t.level > 1)
    .map((t) => [t.id, { id: t.id, level: t.level === 2 ? 2 : 3, text: t.text, page: t.page }]),
);
const notes = appendixFor(kind, item)
  .map((code) => ({ code, title: APPENDICES[code], h: findHeading(idx, code) }))
  .filter((n) => n.h);
const svc = serviceNotes(kind, item)
  .map((n) => ({ ...n, h: findHeading(idx, n.code) }))
  .filter((n) => n.h);
---

<Base
  title={`${KIND_LABEL[kind]} ${item.id} ${item.name}`}
  heading={`${KIND_LABEL[kind]} ${item.id}`}
  nav={listPath}
  h1="bar"
  back={{ path: listPath, label: listLabel }}
>
  <ComponentDetail client:load {kind} {item} mapMeta={DATA.maps[layer]} {related} />
  {
    notes.length > 0 && (
      <div class="notes small">
        {svc.map((n) => (
          <p class="svc">
            <span class="muted">Service notes:</span> {n.text}{' '}
            <a href={href(`handbook/appendix#${n.h!.id}`)}>
              {n.code} {APPENDICES[n.code]}
            </a>
          </p>
        ))}
        <p class="links">
          <span class="muted">Appendices:</span>
          {notes.map((n) => (
            <a href={href(`handbook/appendix#${n.h!.id}`)}>
              {n.code} {n.title}
            </a>
          ))}
        </p>
      </div>
    )
  }
  <nav class="pn" aria-label="Previous and next">
    {
      prev ? (
        <a class="btn sm" href={componentHref(kind, prev.id)}>
          ‹ {prev.id} {prev.name}
        </a>
      ) : (
        <span />
      )
    }
    {
      next ? (
        <a class="btn sm" href={componentHref(kind, next.id)}>
          {next.id} {next.name} ›
        </a>
      ) : (
        <span />
      )
    }
  </nav>
</Base>

<style>
  .notes {
    margin: 18px 0 0;
    border-left: 2px solid var(--brass);
    padding-left: 10px;
  }
  /* The prose measure (spec §3.1) on the text, not the column. */
  .notes p {
    max-width: var(--measure);
    margin: 0 0 4px;
  }
  .notes .links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
  }
  .pn {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    margin-top: var(--gap);
    flex-wrap: wrap;
  }
  .pn .btn {
    text-decoration: none;
  }
</style>
