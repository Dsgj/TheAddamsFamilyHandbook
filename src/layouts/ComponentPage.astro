---
import Icon from '~/components/Icon.astro';
import Base from './Base.astro';
import ComponentDetail from '~/components/ComponentDetail.svelte';
import OwnerHint from '~/components/OwnerHint.svelte';
import WiringList from '~/components/WiringList.svelte';
import { DATA, listOf, mapOf } from '~/lib/data/components';
import type { AnyComponent } from '~/lib/model/types';
import { componentCode, componentLabel, componentName, KIND_PLURAL, kindLine } from '~/lib/copy';
import { wiring, wiringRows } from '~/lib/present';
import { componentHref, handbookHref, tablePath, verifyHref } from '~/lib/url';
import { appendixFor, APPENDICES, serviceNotes } from '~/data/appendix';
import { findHeading } from '~/lib/handbook/render';
import { handbookIndex } from '~/lib/handbook/toc';

/**
 * The component detail page (spec §9.7). The island (ComponentDetail) draws what this device
 * changes: the status, Parts, Location and the Service log. This layout renders the rest once at
 * build and hands the island its Wiring section, the hint and the Related section as slots
 * (SV3-12), then adds the owner's service notes and appendix links (read by the tests) and the
 * prev/next pager (Q18).
 */
interface Props {
  item: AnyComponent;
}
/** A row under "Related": the lamp and coil of the same jet bumper, or the same assembly. */
interface Related {
  href: string;
  code: string;
  name: string;
  sub: string;
}
const { item } = Astro.props;
/** The kind and the list the pager walks come from the item itself (AR3-19). */
const kind = item.kind;
const list = listOf(kind);
const i = list.findIndex((x) => x.id === item.id);
const prev = list[i - 1];
const next = list[i + 1];
/** The list page: a path, for the nav key and the back link (Base adds the base path). */
const listPath = tablePath(kind);
/** The back link's label: the list page's name (a flipper coil's list is the Solenoids page). */
const listLabel = KIND_PLURAL[kind === 'flipper' ? 'coil' : kind];
/** "Switch 32": the page's heading, and the start of its title and description. */
const compName = componentName(kind, item.id);
const w = wiring(item);
/** The LED fitted in this machine (what to order when a lamp dies); '' for non-lamps. */
const led = w.kind === 'lamp' ? w.led : '';
const sw = item.kind === 'switch' ? item : undefined;
const coil = item.kind === 'coil' ? item : undefined;

/** Related components: the same name (the lamp and coil of a jet bumper) or the same assembly. */
const name = item.name.trim().toLowerCase();
const pool: AnyComponent[] = [...DATA.switches, ...DATA.lamps, ...DATA.coils, ...DATA.flippers];
const sameName = (c: AnyComponent) => c.name.trim().toLowerCase() === name;
const related: Related[] = pool
  .filter(
    (c) =>
      c !== item &&
      !('unused' in c && c.unused) &&
      (sameName(c) || (!!item.assy && c.assy === item.assy)),
  )
  .sort((a, b) => Number(sameName(b)) - Number(sameName(a)))
  .slice(0, 8)
  .map((c) => ({
    href: componentHref(c.kind, c.id),
    code: componentCode(c.kind, c.id),
    name: c.name,
    // A lamp names its bulb in place of its matrix place: one line on a phone (spec §9.7).
    sub: kindLine(c.kind, c, { bulb: true }),
  }));

/** Owner appendices that apply to this component, resolved to their Handbook headings. */
const idx = await handbookIndex();
const notes = appendixFor(kind, item)
  .map((code) => ({ code, title: APPENDICES[code], h: findHeading(idx.headings, code) }))
  .filter((n) => n.h);
const svc = serviceNotes(item)
  .map((n) => ({ ...n, h: findHeading(idx.headings, n.code) }))
  .filter((n) => n.h);
---

<Base
  title={componentLabel(kind, item.id, item.name)}
  heading={compName}
  description={`${componentLabel(kind, item.id, item.name)}: where it sits, its part numbers, and its status and service log on this device.`}
  nav={listPath}
  h1="bar"
  back={{ path: listPath, label: listLabel }}
>
  <ComponentDetail client:load {item} mapMeta={mapOf(kind)} {led}>
    <Fragment slot="wiring">
      <section>
        <h3 class="lst-h">Wiring</h3>
        <WiringList rows={wiringRows(w, { parts: false, assembly: false })} variant="dl" card />
      </section>
    </Fragment>
    <Fragment slot="hint">
      <OwnerHint hint={sw?.hint} note={coil?.note} at="detail" />
    </Fragment>
    <Fragment slot="related">
      {
        related.length > 0 && (
          <section>
            <h3 class="lst-h">Related</h3>
            <ul class="lst">
              {related.map((r) => (
                <li>
                  <a class="lrow two" href={r.href}>
                    <span class="code dmd">{r.code}</span>
                    <span class="txt">
                      <span class="ttl">{r.name}</span>
                      <span class="sub">{r.sub}</span>
                    </span>
                    <Icon name="chevron" class="chev" />
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </Fragment>
  </ComponentDetail>
  {
    notes.length > 0 && (
      <div class="notes small">
        {svc.map((n) => (
          <p class="svc">
            <span class="muted">Service notes:</span> {n.text}{' '}
            {n.verify && <a href={verifyHref(n.verify)}>Verify</a>}
            {n.verify && ' · '}
            <a href={handbookHref('appendix', n.h!.id)}>
              {n.code} {APPENDICES[n.code]}
            </a>
          </p>
        ))}
        <p class="links">
          <span class="muted">Appendices:</span>
          {notes.map((n) => (
            <a href={handbookHref('appendix', n.h!.id)}>
              {n.code} {n.title}
            </a>
          ))}
        </p>
      </div>
    )
  }
  <nav class="pn" aria-label="Previous and next">
    {
      prev ? (
        <a class="btn sm" href={componentHref(kind, prev.id)}>
          <Icon name="chevronLeft" class="chev" />
          {componentCode(kind, prev.id)} {prev.name}
        </a>
      ) : (
        <span />
      )
    }
    {
      next ? (
        <a class="btn sm" href={componentHref(kind, next.id)}>
          {componentCode(kind, next.id)} {next.name}
          <Icon name="chevron" class="chev" />
        </a>
      ) : (
        <span />
      )
    }
  </nav>
</Base>

<style>
  .notes {
    margin: 18px 0 0;
    border-left: 2px solid var(--brass);
    padding-left: 10px;
  }
  /* The prose measure (spec §3.1) on the text, not the column. */
  .notes p {
    max-width: var(--measure);
    margin: 0 0 4px;
  }
  /* Spec §12: the appendix links are a list, not running text, so each is a real 44 target and
     none reaches the pager below. */
  .notes .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 12px;
  }
  .notes .links a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch);
  }
  .pn {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    margin-top: var(--gap);
    flex-wrap: wrap;
  }
  .pn .btn {
    text-decoration: none;
  }
  /* The lists' chevron, not a text glyph (VP3-09); Icon's svg is outside this scope. */
  .pn .btn :global(.chev) {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
