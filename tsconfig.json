{
  "extends": "astro/tsconfigs/strictest",
  "compilerOptions": {
    "paths": { "~/*": ["./src/*"] },
    "types": ["vite-plugin-pwa/client"],
    "resolveJsonModule": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true
  },
  "include": [
    ".astro/types.d.ts",
    "src/**/*",
    "scripts/**/*",
    "tests/**/*",
    "astro.config.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
